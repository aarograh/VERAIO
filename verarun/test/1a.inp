[CASEID]
  title 'vera_ornl_xml_1a'

[STATE]
  power 0.0                             ! %
  tinlet 557.33 F                       ! F
  tfuel 565     K                       ! K
  modden 0.743                          ! g/cc
  boron 1300                            ! ppm
  sym qtr  

[STATE]
  power 10.0                            ! %
  tinlet 557.33 F                       ! F
  tfuel 565     K                       ! K
  modden 0.743                          ! g/cc
  boron 1300                            ! ppm

[CORE]
  size 1
  apitch 1.26 
  height 1.0
  rated 0.01 0.01

  core_shape
    1

  assm_map
    ASSY


  bc_rad reflecting
  bc_top reflecting
  bc_bot reflecting
  include mpact_test_mats.ini  
  
[ASSEMBLY]
  npin 1
  ppitch 1.26
  
  fuel U31 10.257 94.5 / 3.1
!  mat he 0.000176
  mat zirc 6.56 zirc4

  cell 1 0.4096 0.418 0.475 / U31 he zirc

  lattice LAT
    1

  axial ASSY 0.0 LAT 1.0 

[EDITS]
     
[MPACT]
  vis_edits         core
  ray_spacing       0.05
!quad_set
  quad_type         CHEBYSHEV-YAMAMOTO
  polars_octant     2
  azimuthals_octant 16
!iteration_control
  flux_tolerance    1e-6
  num_inners        2
  k_tolerance       1e-6
  up_scatter        2
  num_outers        500
  scattering        TCP0
!cmfd
  cmfd              cmfd
  cmfd_solver       mgnode
  k_shift           1.5
  cmfd_num_outers   20
!parallel
  num_space         1
  num_angle         1
  num_energy        1
  num_threads       1
!xs_library
  xs_filename       mpact51g_71_v4.2m5_12062016_sph.fmt
  xs_type           ORNL
  subgroup_set      4
!mesh

  mesh fuel         3 1 1 / 8 8 8 8 8 8
  mesh gtube        3 1   / 8 8 8 8 8

  axial_mesh        1.0000
