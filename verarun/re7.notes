# Build

    (in ~/src/verarun)
    $ python setup.py sdist

Produced `~/src/verarun/dist/verarun-x.y.z.tar.gz`


# Install

## Explicit directory

    (into $DIR)
    $ [ ! -d "${DIR}/lib/python2.7/site-packages" ] && \
        mkdir -p "${DIR}/lib/python2.7/site-packages"
    $ PYTHONPATH="${DIR}/lib/python2.7/site-packages" \
        python setup.py install --prefix="${DIR}"

    > set PYTHONPATH=%DIR%\Lib\site-packages
    > python setup install --prefix="%DIR%"


## User

    $ python setup.py install --user
    (~/.local/lib/python2.7/site-packages)
    (~/.local/bin)
    (~/.local/include/python2.7/{distname})

    (%appdata% == %userprofile%\AppData\Roaming)
    (%appdata%\Python\Python2.7\site-packages)
    (%appdata%\Python\Scripts)
    (%appdata%\Python\Python2.7\Include{distname})

## Home

    $ python setup.py install --home=<dir>
    (~/lib/python2.7/site-packages)
    (~/bin)
    (~/include/python2.7/{distname})

    (%userprofile%\Python2.7\site-packages)
    (%userprofile%\Scripts)
    (%userprofile%\Python2.7\Include{distname})


