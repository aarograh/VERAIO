#!/bin/bash
{pbs_env}

cd "${work_dir_env}"

# Local environment
VERA_PATH="{vera_path}"
. "${{VERA_PATH}}/load_env.sh"
shopt -s extglob

case={case} 
excore_filename={excore_filename}
cores={cores:d}
head_hostname={head_hostname}
restart={restart}
run_ctf={run_ctf}
run_mpact={run_mpact}
run_multistate_cobra={run_multistate_cobra}
run_shift={run_shift}
run_thermal_exp={run_thermal_exp}
run_verain={run_verain}

#	-- Feedback
#       --
date +'%a %F %T %Z'
cat <<END
case = {case}
input = {case}.inp
job = ${job_id_env}, ${job_name_env}
pwd = $PWD

Control
---------------------------------------------
case=$case
cores=$cores
restart=$restart
run_ctf=$run_ctf
run_mpact=$run_mpact
run_multistate_cobra=$run_multistate_cobra
run_shift=$run_shift
run_thermal_exp=$run_thermal_exp
run_verain=$run_verain

Environment
---------------------------------------------
VERA_PATH=$VERA_PATH
MPACT_DATA=$MPACT_DATA
SCALE=$SCALE
DATA=$DATA
PATH=$PATH
LD_LIBRARY_PATH=$LD_LIBRARY_PATH
END
module list

#	-- VERARepoVersion.txt
#       --
if [ -r "$VERA_PATH/VERARepoVersion.txt" ]; then
  cat <<END

VERA Versions
---------------------------------------------
$(cat "$VERA_PATH/VERARepoVersion.txt")
---------------------------------------------
END
fi


#	-- VERAIn
#	--
if [ "$run_verain" ]; then
  [ -f "$case.xml" ] && rm -f "$case.xml"
  cat <<END

=============================================
  Parsing VERA input $case.inp
=============================================
END
  react2xml.pl "$case.inp" "$case.xml"
  ls -l "$case.xml"
  date +'%a %F %T %Z'
fi


#	-- ThermalExpandXML
#	--
if [ "$run_thermal_exp" -a -f "$case.xml" ]; then
  [ -f "$case.orig.xml" ] && rm -f "$case.orig.xml"
  cat <<END

=============================================
  Thermally expanding input
=============================================
END
  mv "$case.xml" "$case.orig.xml"
  ThermalExpandXML.exe \
      --input="$case.orig.xml" --output="$case.xml" \
      --expand3D=false \
      --verbosity=3
  ls -l "$case.xml"
  date +'%a %F %T %Z'
fi


# Not needed from VERA-4.0 and beyond
#	-- xml2ctf
#	--
#if [ "$run_ctf" -a -f "$case.xml" ]; then
#  rm -f *deck.*
#  cat <<END
#
#=============================================
#  Running CTF Preprocessor
#=============================================
#END
#  xml2ctf --xmlfile="$case.xml"
#  ls -l *deck.*
#  date +'%a %F %T %Z'
#fi


#	-- multistate_cobra
#	--
if [ "$run_multistate_cobra" -a -f "$case.xml" ]; then
  cp "$case.xml" deck.xml
  cat <<END

=================================================
  Running multistate_cobra job on {cores:d} cores
=================================================
END
  #multistate_cobra -xmlfile=deck.xml
  mpiexec {mpi_args} \
      -n $cores multistate_cobra deck.xml
  date +'%a %F %T %Z'
fi


#	-- MPACT.exe
#	--
mpact_exe=
if [ "$run_shift" ]; then
  mpact_exe=vera_to_shift
elif [ "$run_mpact" ]; then
  mpact_exe=MPACT.exe
fi

if [ "$mpact_exe" -a -f "$case.xml" ]; then
#		-- Restart staging
#		--
  if [[ "$restart" == *write ]]; then
    [[ "$restart" != readwrite && -f *.res ]] && rm -f *.res
    tmpdir="temp_${job_id_env}"
    mkdir -p "$tmpdir"
    cp * "$tmpdir"
    pushd "$tmpdir"
  fi
  #rm -f *.res || true
  cat <<END

=============================================
  Running $mpact_exe job on {cores:d} cores
=============================================
END
#  mpiexec \
#      -env MV2_HCA_AWARE_PROCESS_MAPPING 0 \
#      -env MV2_SHMEM_DIR "/tmp" \
#      -n $cores $mpact_exe "$case.xml"
  if [[ "$mpact_exe" == "MPACT.exe" ]]; then
    mpiexec {mpi_args} \
        -n $cores $mpact_exe "$case.xml"

  else  # you are running vera_to_shift
    if [[ "$excore_filename" ]]; then
      excore_omn_name="${{excore_filename%%.excore.xml}}.omn"
      if [ ! -f "$excore_omn_name" ]; then
        cat <<END
************************************************************************
!!!!! Error, please include $excore_omn_name !!!!!
************************************************************************
END
      else
        excore2xml "$excore_omn_name"
      fi
    fi

    mpiexec {mpi_args} \
        -n $cores $mpact_exe --i="$case.xml"
  fi
  date +'%a %F %T %Z'

#		-- Restart unstaging
#		--
  if [[ "$restart" == *write ]]; then
    [[ "$restart" != readwrite && -f *.res ]] && rm -f *.res
    mv !($case.xml) "${work_dir_env}"
    popd
    rm -fr "$tmpdir"
  fi

#               -- Summary email
#               --
  if [ -f "$case.sum" ]; then
    if [ -z "$SLURM_JOB_ID" ]; then
      shost="$PBS_O_HOST"
      sjob_id="$PBS_JOBID"
      sjob_name="$PBS_JOBNAME"
      swork_dir="$PBS_O_WORKDIR"
    else
      shost="$SLURM_SUBMIT_HOST"
      sjob_id="$SLURM_JOB_ID"
      sjob_name="$SLURM_JOB_NAME"
      swork_dir="$SLURM_SUBMIT_DIR"
    fi
    saddrs=$(echo "{email_addrs}" | sed -e 's/,/ /g')
    sfile=$(mktemp -t vera.summary.XXXXXX)
    ssubject="Finished running job $sjob_id on $shost"
    stitle=$(grep -F title "$case.inp" | sed -e 's/^\s*//' -e 's/\s+/ /g' | cut -d' ' -f2)
    cat > "$sfile" <<END
Finished running VERA job on $shost

Title: $stitle

Run Directory:    $swork_dir
PBS JOBID:        $sjob_id
PBS JOBNAME:      $sjob_name
HDF Output File:  $case.h5

END
    tail -n +$(grep -n -F 'Case Summary' $case.sum | cut -d: -f1) $case.sum >> "$sfile"
    echo [verarun] ssh $head_hostname "mailx {mailfrom} -s '\"$ssubject\"' $saddrs"
    cat "$sfile" | ssh $head_hostname "mailx {mailfrom} -s '\"$ssubject\"' $saddrs"
    if [ $? -ne 0 ]; then
      echo "[verarun] mailx failed, summary content"
      cat "$sfile"
    fi
    unlink "$sfile"
  fi
fi # MPACT


