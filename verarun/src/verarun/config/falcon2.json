{
"domain": "inl.gov",

"email_env":
  [
    "#PBS -M {email_addrs}",
    "#PBS -m ea"
  ],

"env": [ "export OMP_NUM_THREADS=1" ],
"_env_old":
  [
    "module load MVAPICH2/2.2-GCC-5.4.0-2.28"
  ],

"hostname": "falcon2",

"mail_from": "hpc@inl.gov",

"mpi_args": [],

"pbs": "Torque",

"pbs_env":
  [
    "#PBS -N {job_name}",
    "#PBS -o {case}.stdout",
    "#PBS -l select={nodes:d}:ncpus=36:mpiprocs={ppn:d}",
    "#PBS -l walltime={walltime}",
    "#PBS -j oe"
  ],
"_pbs_env_old": [ "#PBS -q casl" ],

"pmem_env":
  [
    "#PBS -l pmem={pmem}"
  ],

"project_default": "vera",
"project_env": "#PBS -P {project}",

"specs":
  {
  "hwthreads": 1,
  "units": 18,
  "sockets": 2,
  "nodes": 828,
  "mem": 128
  },

"_VeraDefaultVersion": "VERA_4.0RC4",
"VeraInstallsDir": "/projects/vera-cs-user/VERA_builds_falcon/builds"
}
