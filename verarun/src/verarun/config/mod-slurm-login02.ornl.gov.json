{
"default_queue": "batch",
"domain": "ornl.gov",

"email_env":
  [
    "#SBATCH --mail-user={email_addrs}",
    "#SBATCH --mail-type=END"
  ],

"env": [],
"_env_old": [ "module load mpi/mvapich/gnu/2.2rc1" ],

"hostname": "mod-slurm-login02.ornl.gov",

"mail_from": "no-reply@ornl.gov",

"mem_default_env":
  [
    "#SBATCH --mem={nmem}"
  ],

"pbs": "Slurm",

"pbs_env":
  [
    "#SBATCH --job-name={job_name}",
    "#SBATCH --output={case}.stdout",
    "#SBATCH --nodes={nodes:d}",
    "#SBATCH --ntasks-per-node={ppn:d}",
    "#SBATCH --partition={queue}",
    "#SBATCH --time={walltime}"
  ],

"pmem_env":
  [
    "#SBATCH --mem-per-cpu={pmem}"
  ],

"project_default": "nsed",
"project_env": "#SBATCH --account={project}",

"specs":
  {
  "hwthreads": 1,
  "units": 16,
  "sockets": 2,
  "nodes": 150,
  "mem": 125
  },

"VeraDefaultVersion": "VERA_4.2RC7",
"VeraInstallsDir": "/software/user_tools/current/cades-nsed-veracs/VERA_builds/builds"
}
