{
"domain": "inl.gov",

"email_env":
  [
    "#PBS -M {email_addrs}",
    "#PBS -m ea"
  ],

"env": [],
"_env_old":
  [
    "module load MVAPICH2/2.2-GCC-5.4.0-2.28"
  ],

"hostname": "lemhi1",

"mail_from": "hpc@inl.gov",

"mpi_args": [],

"pbs": "Torque",

"pbs_env":
  [
    "#PBS -N {job_name}",
    "#PBS -o {case}.stdout",
    "#PBS -l select={nodes:d}:ncpus=40:mpiprocs={ppn:d}",
    "#PBS -l walltime={walltime}",
    "#PBS -j oe"
  ],

"pmem_env":
  [
    "#PBS -l pmem={pmem}"
  ],

"project_default": "vera",
"project_env": "#PBS -P {project}",

"specs":
  {
  "hwthreads": 1,
  "units": 20,
  "sockets": 2,
  "nodes": 504,
  "mem": 192
  },

"_VeraDefaultVersion": "VERA_4.0RC3",
"VeraInstallsDir": "/projects/vera-users-grp/VERA_builds_lemhi/builds/"
