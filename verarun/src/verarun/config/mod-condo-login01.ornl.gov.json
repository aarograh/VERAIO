{
"domain": "ornl.gov",

"email_env":
  [
    "#PBS -M {email_addrs}",
    "#PBS -m ea"
  ],

"env": [],
"_env_old": [ "module load mpi/mvapich/gnu/2.2rc1" ],

"hostname": "mod-condo-login01.ornl.gov",

"mail_from": "no-reply@ornl.gov",

"mpi_args":
  [
    "-env MV2_HCA_AWARE_PROCESS_MAPPING 0",
    "-env MV2_SHMEM_DIR \"/tmp\""
  ],

"pbs": "Torque",

"pbs_env":
  [
    "#PBS -N {job_name}",
    "#PBS -o {case}.stdout",
    "#PBS -l nodes={nodes:d}:ppn={ppn:d}",
    "#PBS -l walltime={walltime}",
    "#PBS -j oe",
    "#PBS -q {queue}",
    "#PBS -l qos=std",
    "#PBS -W group_list=cades-nsed"
  ],

"pmem_env":
  [
    "#PBS -l pmem={pmem}"
  ],

"project_default": "NSED",
"project_env": "#PBS -A {project}",

"specs":
  {
  "hwthreads": 1,
  "units": 16,
  "sockets": 2,
  "nodes": 150,
  "mem": 128
  },


"_VeraDefaultVersion": "VERA_4.0RC4",
"VeraInstallsDir": "/software/user_tools/current/cades-nsed-veracs/VERA_builds/builds"
}
