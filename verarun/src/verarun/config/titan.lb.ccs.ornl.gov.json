{
"VeraInstallsDir": "/vera",
"env": [],
"hostname": "titan.lb.ccs.ornl.gov",
"machine":
  {
  "hwthreads": 2,
  "units": 4,
  "sockets": 2,
  "nodes": 18688,
  "mem": 32
  },

"pbs_env":
  [
    "#PBS -N {job_name}",
    "#PBS -o {case}.stdout",
    "#PBS -l nodes={nodes:d}:ppn={ppn:d}",
    "#PBS -l walltime={walltime}",
    "#PBS -j oe",
    "#PBS -A {account}",
    "#PBS -q {queue}"
  ],

"email_env":
  [
    "#PBS -M {email_addrs}",
    "#PBS -m ea"
  ],

"pmem_env":
  [
    "#PBS -l pmem={pmem:d}gb"
  ],

"env": []
}
