#!/bin/bash
#PBS -j oe
#PBS -l select="{nodes:d}:ncpus={ppn:d}:mpiprocs={ppn:d}"

module load gmvapich2/4.5.0

# Local environment
VERA_PATH="/tools/vera_installs/vera-3.8.0"
. "/tools/vera_installs/vera-3.8.0/load_env.sh"
shopt -s extglob

cd $PBS_O_WORKDIR

#	-- Feedback
#       --
date
cat <<END
case = ross1
input = ross1.inp

Control
---------------------------------------------
case=ross1 
cores=128
restart=
run_ctf=true
run_mpact=true
run_multistate_cobra=
run_shift=
run_thermal_exp=true
run_verain=true

Environment
---------------------------------------------
DATA=$DATA
MPACT_DATA=$MPACT_DATA
SCALE=$SCALE
VERA_PATH=$VERA_PATH

job = $PBS_JOBID
pwd = $PWD
END

#	-- VERARepoVersion.txt
#       --
if [ -r "/tools/vera_installs/vera-3.8.0/VERARepoVersion.txt" ]; then
  cat <<END

VERA Versions
---------------------------------------------
$(cat "/tools/vera_installs/vera-3.8.0/VERARepoVersion.txt")
---------------------------------------------
END
fi


#	-- VERAIn
#	--
if [ "true" ]; then
  [ -f "ross1.xml" ] && rm -f "ross1.xml"
  cat <<END

=============================================
  Parsing VERA input ross1.inp
=============================================
END
  react2xml.pl "ross1.inp" "ross1.xml"
  ls -l "ross1.xml"
  date
fi


#	-- ThermalExpandXML
#	--
if [ "true" -a -f "ross1.xml" ]; then
  [ -f "ross1.orig.xml" ] && rm -f "ross1.orig.xml"
  cat <<END

=============================================
  Thermally expanding input
=============================================
END
  mv "ross1.xml" "ross1.orig.xml"
  ThermalExpandXML.exe \
      --input="ross1.orig.xml" --output="ross1.xml" \
      --expand3D=false \
      --verbosity=3
  ls -l "ross1.xml"
  date
fi


#	-- xml2ctf
#	--
if [ "true" -a -f "ross1.xml" ]; then
  rm -f *deck.*
  cat <<END

=============================================
  Running CTF Preprocessor
=============================================
END
  xml2ctf --xmlfile="ross1.xml"
  ls -l *deck.*
  date
fi


#	-- multistate_cobra
#	--
if [ "" -a -f "ross1.xml" ]; then
  cp "ross1.xml" deck.xml
  cat <<END

=================================================
  Running multistate_cobra Job on 128 cores
=================================================
END
  multistate_cobra -xmlfile=deck.xml
#  mpiexec \
#      -env MV2_HCA_AWARE_PROCESS_MAPPING 0 \
#      -env MV2_SHMEM_DIR "/tmp" \
#      -n 128 multistate_cobra deck.xml
  date
fi


#	-- MPACT.exe
#	--
mpact_exe=
if [ "true" ]; then
  mpact_exe=MPACT.exe
elif [ "" ]; then
  mpact_exe=vera_shift
fi

if [ "${mpact_exe}" -a -f "ross1.xml" ]; then
#		-- Restart staging
#		--
  if [[ "" == *write ]]; then
    [[ "" != readwrite && -f *.res ]] && rm -f *.res
    tmpdir="temp_$PBS_JOBID"
    mkdir -p "$tmpdir"
    cp * "$tmpdir"
    pushd "$tmpdir"
  fi
  #rm -f *.res || true
  cat <<END

=============================================
  Running MPACT Job on 128 cores
=============================================
END
  mpiexec \
      -env MV2_HCA_AWARE_PROCESS_MAPPING 0 \
      -env MV2_SHMEM_DIR "/tmp" \
      -n 128 ${mpact_exe} "ross1.xml"
  date

#		-- Restart unstaging
#		--
  if [[ "" == *write ]]; then
    [[ "" != readwrite && -f *.res ]] && rm -f *.res
    mv !(ross1.xml) "$PBS_O_WORKDIR"
    popd
    rm -fr "$tmpdir"
  fi
fi # MPACT


#	-- Cleanup
#	--
  cat <<END

=============================================
  Cleaning up
=============================================
END
if [ "${mpact_exe}" -a "true" ]; then
#  if [ -f "ross1.h5" -a -f pdeck.ctf.h5 ]; then
#    get_ctf_data.sh "ross1.h5"
#    mv "ross1.h5_new.h5" "ross1_final.h5"
#  fi
  rm -f cpld_temp_dens_summary.out pmaster* pdeck*.inp pdeck*.out || true
  date
fi
