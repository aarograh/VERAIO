          369.7898
          377.711

[COBRATF]
  nfuel   3             ! number of fuel rings in conduction model
  nc      1             ! conduction option - radial conduction
  irfc    2             ! friction factor correlation default=2
  dhfrac  0.02          ! fraction of power deposited directly into coolant
!!hgap    5678.3        ! gap conductance
  epso    0.001
  oitmax  5
  iitmax  40
  dtmin   0.000001
  dtmax   0.1
  tend    0.1
  rtwfp   1000.0
  maxits  10000
  courant 0.8

[COUPLING]
  epsk        5.0  ! pcm
  epsp        1.0e-4
  rlx_power   0.6
  rlx_tfuel   1.0
  rlx_den     1.0
  maxiter     100

[MPACT]
  num_space      29
  num_angle      1
  num_threads    1
