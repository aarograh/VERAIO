[CASEID]
  title 'Sample 2D GE9 BWR Lattice'

!------------------------------------------------------------------------------
! Geometry Reference:
! D. J. Kelly,
! "Depletion of a BWR Lattice Using the RACER Continuous Energy
!    Monte Carlo Code,”
! Proc. Int. Conf. on Math and Comp., Reactor Physics, and Env. Analysis,
! Portland, Oregon, USA, April 30-May 4 (1995).
!------------------------------------------------------------------------------

[STATE]
  power    100.0
  tinlet   550 K  ! *** approximate
  tfuel    900 K
  pressure 1040   ! psia
  sym      full

  void  
    40.0

!** at void 00,  rho=  0.736690 g/cc
!** at void 40,  rho=  0.457023 g/cc
!** at void 70,  rho=  0.247273 g/cc


[CORE]
  bwr    true
  size   1
  apitch 15.24
  height 1.0
  rated  0.01 0.01   ! *** approximate

  core_shape
    1

  assm_map
    ASSY

  bc_rad reflecting
  bc_top reflecting
  bc_bot reflecting

  mat zirc4  6.56 zirc4

[ASSEMBLY]
  npin   8
  ppitch 1.6256          ! pin pitch - does not include channel gaps
  gap    0.9525 0.47498  ! wide and narrow channel gap (cm)

  channel  0.2032 0.9652 0.0 0.0   ! channel dimensions 

!** Note that the automatic addition of U-234 does not agree with the spec
!** and we may need to add these explicitly

  fuel U16  10.0642 94.5 / 1.6
  fuel U20  10.0642 94.5 / 2.0
  fuel U22  10.0642 94.5 / 2.2
  fuel U24  10.0642 94.5 / 2.4
  fuel U26  10.0642 94.5 / 2.6
  fuel U28  10.0642 94.5 / 2.8
  fuel U30  10.0642 94.5 / 3.0
  fuel U36  10.0642 94.5 / 3.6
  fuel U36G  9.939  94.5 / 3.6 / gad=4.0
  fuel U38  10.0642 94.5 / 3.8
  fuel U40  10.0642 94.5 / 3.95
  fuel U40G  9.939  94.5 / 3.95 / gad=4.0

  cell  1 0.53213 0.61341 / U16  zirc4
  cell  2 0.53213 0.61341 / U20  zirc4
  cell  3 0.53213 0.61341 / U22  zirc4
  cell  4 0.53213 0.61341 / U24  zirc4
  cell  5 0.53213 0.61341 / U26  zirc4
  cell  6 0.53213 0.61341 / U28  zirc4
  cell  7 0.53213 0.61341 / U30  zirc4
  cell  8 0.53213 0.61341 / U36  zirc4
  cell  9 0.53213 0.61341 / U38  zirc4
  cell 10 0.53213 0.61341 / U40  zirc4
  cell 51 0.53213 0.61341 / U40G zirc4
  cell 52 0.53213 0.61341 / U36G zirc4

!** model 4 small water rods for now
!** cell WR 1.6002 1.7018 / mod zirc4  LARGE4 **

  cell WR 0.7109 0.8125 / mod zirc4


  lattice LAT
    1
    2  6
    4  8 10
    6 10 52 WR
    6 10 10 WR WR
    6 10 51 10 10 10
    5  9 10 51 10 51 10
    3  7  9 10 10 10  9  6

  axial ASSY 0.0 LAT 1.0

[MPACT]
  num_space      1
  num_angle      8
  num_threads    1

[INSILICO]
  num_blocks_i   4
  num_blocks_j   4
