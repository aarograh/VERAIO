          177.695 
          181.505 
          189.57 
          197.635 
          205.7 
          213.765 
          221.83 
          229.895 
          233.705 
          241.77 
          249.835 
          257.9 
          265.965 
          274.03 
          282.095 
          285.905 
          293.97 
          302.035 
          310.1 
          318.165 
          326.23 
          334.295 
          338.105 
          346.0262 
          353.9474 
          361.8686 
          369.7898 
          377.711

[INSILICO]
    do_transport  false
    eq_set        ld
    eigen_solver  arnoldi
    tolerance     1e-06
    Pn_order      1
    dimension     3
    mesh          4
!    eigenvalue_db:
        k_tolerance  0.0001
        L2_tolerance 0.001
        energy_dep_ev  false
    max_delta_z   2.54
    num_blocks_i  1
    num_blocks_j  1
    num_z_blocks  1
    num_groups    8
    num_sets      1
!    quadrature_db:
        azimuthals_octant  4
        polars_octant      4
        quad_type          qr
!    silo_db:
        silo_output  vera
!    upscatter_db:
        upscatter_tolerance  1e-05
    xs_library     "test-8grp"
