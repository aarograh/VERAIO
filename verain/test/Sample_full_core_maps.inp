! Parser: Following card is used to define control_num_levels, control_axial_heights,
!   and control_cellmap_axial_level  (from the cellmap sublist)

! ** check elevations
! Note: "1" corresponds control rod type in "crd_map" in CORE block

  axial 1 15.76 AIC  376.44 B4C  394.3

[INSERT]
