! Author : Bob Salko
! Date : 2/09/2022
! Description:
!   A parallel nodal model that tests the domain_decomp input in VERAIo
!

!> @beginreq
!> - VERAIO shall support the user inputting a domain decomposition map that can be used by
!> CTF for decomposing the model for parallel solution.
!> @endreq


[CASEID]
  title 'CASL Problem 3x3 HFP'
!================================================================================
!  Sample input for small 3x3 Problem
!
!  Added 3/25/2013 in order to test multi-assembly capabilities of COBRA
!
!  To process:
!     ./react2xml.pl [file].inp [file].xml
!
!================================================================================

[STATE]
  power  100.0         ! %
  tinlet 559.0 F         ! F
  boron  1300          ! ppmB
  pressure 2250        ! psia

  tfuel 900.0 K         ! K - 600K  Not used with T/H feedback! set to 900K with feedback
  modden 0.743         ! g/cc      Not used with T/H feedback!

  feedback on
  sym qtr

[CORE]
  size 3                ! 3x3 cross - 5 assemblies
!  rated 0.53545 0.02125 ! MW, Mlbs/hr  *** For 1 active fuel pin in bundle
!  rated 1.07090 0.04250 ! MW, Mlbs/hr  *** For 2 active fuel pins in bundle
!  rated 1.60635 0.06375 ! MW, Mlbs/hr  *** For 3 active fuel pins in bundle
!  rated 2.1418  0.08500 ! MW, Mlbs/hr  *** For 4 active fuel pins in bundle
  rated 2.67725  0.10625 ! MW, Mlbs/hr  *** For 5 active fuel pins in bundle
!  rated 4.28360  0.17000 ! MW, Mlbs/hr  *** For 8 active fuel pins in bundle
!  rated 4.81905  0.19125 ! MW, Mlbs/hr  *** For 9 active fuel pins in bundle
  apitch 3.78           ! *** scaled to 3x3, no gap
  height 406.328

  core_shape
    0 1 0
    1 1 1
    0 1 0

  assm_map
      A1
   A1 A2 A1
      A1

  lower_plate ss 5.0 0.5   ! mat, thickness, vol frac
  upper_plate ss 7.6 0.5   ! mat, thickness, vol frac
  lower_ref   mod 26.0 1.0
  upper_ref   mod 25.0 1.0

  bc_rad reflecting
  bc_sym rot

  mat he     0.000176
  mat inc    8.19
  mat ss     8.0
  mat zirc   6.56 zirc4
  mat aic   10.20
  mat pyrex  2.23
  mat b4c    6.56

[ASSEMBLY]
  title "A1"
  npin 3    ! *** scaled to 3x3
  ppitch 1.260

  fuel U31 10.257 95.0 / 3.1
  fuel U32 10.257 94.0 / 3.1

  cell 1     0.4096 0.418 0.475 / U31 he zirc
  cell 2     0.4095 0.417 0.476 / U32 he zirc
  cell 100          0.561 0.602 / mod    zirc       ! guide tube
  cell 200          0.561 0.602 / mod    zirc       ! instrument tube
  cell 201          0.562 0.605 / mod    zirc       ! instrument tube 2
  cell 7            0.418 0.475 / mod    mod        ! empty location
  cell 8            0.418 0.475 /     he zirc       ! plenum
  cell 9                  0.475 /        zirc       ! pincap

  lattice FUEL1
     200
       1 1

  lattice FUEL2
     201
       2 2

  lattice LGAP1
     200
       7 7

  lattice PLEN1
     200
       8 8

  lattice PCAP1
     200
       9 9

  axial A1    6.050
      LGAP1  10.281
      PCAP1  11.951
      FUEL1 377.711
      PLEN1 393.711
      PCAP1 395.381
      LGAP1 397.501

  grid END inc 3.866 31.67 / loss=0.9070 ! height (cm), mass (g), loss coef *** scaled to 3x3
  grid MID zirc 3.810 27.25 / loss=1.0 yhl1=5.0 yhl2=-0.1 ! height (cm), mass (g), loss coef *** scaled to 3x3

  grid_axial
      END  13.884
      MID  75.2
      MID 127.4
      MID 179.6
      MID 231.8
      MID 284.0
      MID 336.2
      END 388.2

  lower_nozzle  ss 6.05  194.64  ! mat, height, mass (g)  *** mass scaled to 3x3
  upper_nozzle  ss 8.827 194.64  ! mat, height, mass (g)  *** mass scaled to 3x3

[ASSEMBLY]
  title "A2"
  npin 3    ! *** scaled to 3x3
  ppitch 1.260

  fuel U31 10.257 95.0 / 3.1
  fuel U32 10.257 94.0 / 3.1

  cell 1     0.4096 0.418 0.475 / U31 he zirc
  cell 2     0.4095 0.417 0.476 / U32 he zirc
  cell 100          0.561 0.602 / mod    zirc       ! guide tube
  cell 200          0.561 0.602 / mod    zirc       ! instrument tube
  cell 201          0.562 0.605 / mod    zirc       ! instrument tube 2
  cell 7            0.418 0.475 / mod    mod        ! empty location
  cell 8            0.418 0.475 /     he zirc       ! plenum
  cell 9                  0.475 /        zirc       ! pincap

  lattice FUEL1
     200
       1 1

  lattice FUEL2
     201
       2 2

  lattice LGAP1
     200
       7 7

  lattice PLEN1
     200
       8 8

  lattice PCAP1
     200
       9 9

  axial A2    6.050
      LGAP1  10.281
      PCAP1  11.951
      FUEL2 377.711
      PLEN1 393.711
      PCAP1 395.381
      LGAP1 397.501

  grid END inc 3.866 31.67 / loss=0.9070 ! height (cm), mass (g), loss coef *** scaled to 3x3
  grid MID zirc 3.810 27.25 / loss=0.5 blockage=0.1 yhl1=4.0 yhl2=-0.15 ! height (cm), mass (g), loss coef *** scaled to 3x3

  grid_axial
      END  13.884
      MID  75.2
      MID 127.4
      !MID 179.6
      MID 231.8
      MID 284.0
      MID 336.2
      END 388.2

  lower_nozzle  ss 6.05  194.64  ! mat, height, mass (g)  *** mass scaled to 3x3
  upper_nozzle  ss 8.827 194.64  ! mat, height, mass (g)  *** mass scaled to 3x3

[EDITS]

!  3in intervals in active fuel
  axial_edit_bounds
          11.951
          15.817
          24.028
          32.239
          40.45
          48.662
          56.873
          65.084
          73.295
          77.105
          85.17
          93.235
          101.3
          109.365
          117.43
          125.495
          129.305
          137.37
          145.435
          153.5
          161.565
          169.63
          177.695
          181.505
          189.57
          197.635
          205.7
          213.765
          221.83
          229.895
          233.705
          241.77
          249.835
          257.9
          265.965
          274.03
          282.095
          285.905
          293.97
          302.035
          310.1
          318.165
          326.23
          334.295
          338.105
          346.0262
          353.9474
          361.8686
          369.7898
          377.711


[MPACT]
  transport_method nodal

[COBRATF]
  nfuel   3             ! number of fuel rings in conduction model
  hgap    5678.3        ! gap conductance
  solver 0
  edit_native_hdf5 1
  domain_decomp
     1
   2 3 2
     1
  nodal_inter_assem_gap_width_uniform 0
  nodal_gap_len_node_centers 0
  nodal_inter_assem_loss 0.0

