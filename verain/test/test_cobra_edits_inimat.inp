[CASEID]
  title 'CASL Problem 3x3 HFP'
!================================================================================
!  Sample input for small 3x3 Problem
!
!  Updated 3/18/2013 to be consistent with Problem 6 T/H
!
!  To process:
!     ./react2xml.pl [file].inp [file].xml
!
!================================================================================

[STATE]
  power  100.0         ! %
  tinlet 559.0 F         ! F
  boron  1300          ! ppmB
  pressure 2250        ! psia

  tfuel 900.0 K         ! K - 600K  Not used with T/H feedback! set to 900K with feedback
  modden 0.743         ! g/cc      Not used with T/H feedback!

  feedback on
  sym full

[CORE]
  size 1                ! 1x1 single-assembly
  rated 0.53545 0.02125 ! MW, Mlbs/hr  *** scaled to 3x3
  apitch 3.78           ! *** scaled to 3x3, no gap
  height 406.328

  core_shape
    1

  assm_map
    A1

  lower_plate ss 5.0 0.5   ! mat, thickness, vol frac
  upper_plate ss 7.6 0.5   ! mat, thickness, vol frac
  lower_ref   mod 26.0 1.0
  upper_ref   mod 25.0 1.0

  bc_rad reflecting

  mat he     100.000176
  mat inc    108.19
  mat ss     108.0
  mat zirc   106.56
  mat aic   1010.20
  mat pyrex  102.23
  mat b4c    106.56

[ASSEMBLY]
  title "Westinghouse 17x17"
  npin 3    ! *** scaled to 3x3
  ppitch 1.260

  fuel U31 10.257 95.0 / 3.1

!=== material label, key_name, density (lib_name defaults to key_name)
  mat he   200.000176
!  mat he   0
  mat inc  208.19
  mat ss   208.0
  mat zirc 206.56

  cell 1     0.4096 0.418 0.475 / U31 he zirc
  cell 100          0.561 0.602 / mod    zirc       ! guide tube
  cell 200          0.561 0.602 / mod    zirc       ! instrument tube
  cell 7            0.418 0.475 / mod    mod        ! empty location
  cell 8            0.418 0.475 /     he zirc       ! plenum
  cell 9                  0.475 /        zirc       ! pincap

  lattice FUEL1
     200
       1 1

  lattice LGAP1
     200
       7 7

  lattice PLEN1
     200
       8 8

  lattice PCAP1
     200
       9 9

  axial A1    6.050
      LGAP1  10.281
      PCAP1  11.951
      FUEL1 377.711
      PLEN1 393.711
      PCAP1 395.381
      LGAP1 397.501

  grid END inc  3.866  31.67  0.9070 ! height (cm), mass (g), loss coef  *** scaled to 3x3
  grid MID zirc 3.810  27.25  0.9065 ! height (cm), mass (g), loss coef  *** scaled to 3x3

  grid_axial
      END  13.884
      MID  75.2
      MID 127.4
      MID 179.6
      MID 231.8
      MID 284.0
      MID 336.2
      END 388.2

  lower_nozzle  ss 6.05  194.64  ! mat, height, mass (g)  *** mass scaled to 3x3
  upper_nozzle  ss 8.827 194.64  ! mat, height, mass (g)  *** mass scaled to 3x3

[EDITS]

!  3in intervals in active fuel
  axial_edit_bounds
          11.951
          15.817
          24.028
          32.239
          40.45
          48.662
          56.873
          65.084
          73.295
          77.105
          85.17
          93.235
          101.3
          109.365
          117.43
          125.495
          129.305
          137.37
          145.435
          153.5
          161.565
          169.63
          177.695
          181.505
          189.57
          197.635
          205.7
          213.765
          221.83
          229.895
          233.705
          241.77
          249.835
          257.9
          265.965
          274.03
          282.095
          285.905
          293.97
          302.035
          310.1
          318.165
          326.23
          334.295
          338.105
          346.0262
          353.9474
          361.8686
          369.7898
          377.711

[INSILICO]
    mat_library casl_comp.sh5
    xs_library  v7-252

    max_delta_z   2.54
    num_blocks_i  3
    num_blocks_j  3
    num_z_blocks  12
    num_groups    23
    num_sets      8

    mesh          4
    dimension     3
    eq_set        sc
    eigen_solver  arnoldi
    tolerance     1e-6
    Pn_order      0

!   eigenvalue_db:
       k_tolerance   1e-4
       L2_tolerance  1e-3
       energy_dep_ev true

!   quadrature_db:
       quad_type          qr
       azimuthals_octant  4
       polars_octant      4

!   silo_db:
       silo_output  p6
!      silo_out_power true

!   upscatter_db:
       upscatter_tolerance  1e-4

    new_grp_bounds
       8.2085e+05
       1.1109e+05
       5.5308e+03
       1.8644e+02
       3.7612e+01
       3.5379e+01
       2.7697e+01
       2.1684e+01
       2.0397e+01
       1.5968e+01
       7.1500e+00
       6.7000e+00
       6.3000e+00
       1.0970e+00
       1.0450e+00
       9.5000e-01
       3.5000e-01
       2.0600e-01
       1.0700e-01
       5.8000e-02
       2.5000e-02
       1.0000e-02
       1.0000e-05

[COBRATF]
  nfuel   3             ! number of fuel rings in conduction model
  nc      1             ! conduction option - radial conduction
  irfc    2             ! friction factor correlation default=2
  dhfrac  0.02          ! fraction of power deposited directly into coolant
  hgap    5678.3        ! gap conductance
  epso    0.001
  oitmax  5
  iitmax  40
  dtmin   0.000001
  dtmax   0.1
  tend    0.1
  rtwfp   1000.0
  maxits  10000
  courant 0.8
  maps_filename = 3x3_HFP
  edit_gaps 0         ! Generate the gaps.out file and print gap results
  edit_channels 0     ! Generate the channels.out file and print channel results
  edit_rods 1         ! Print rod results (found in deck.out)
  edit_dnb 0          ! Generate the dnb.out file


[MAMBA2D]
  Nx   50
  Ny   40
  tmax 400.0

[COUPLING]
  epsk        5.0  ! pcm
  eps_temp    1.0  ! temperature convergence in C
  eps_boron   0.1  ! boron convergence (ppm)
  rlx_power   0.5
  rlx_tfuel   1.0
  rlx_den     1.0
  maxiter     100

