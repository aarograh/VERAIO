<?xml version="1.0" encoding="utf-8"?>
<ParameterList>
  <ParameterList name="CASEID">
    <Parameter name="CASEID" type="string" value="CASL Westinghouse Pin Cell - Public - Rev. 0&#10;"/>
  </ParameterList>
  <ParameterList name="STATE">
    <Parameter name="power" type="double" value="0.0"/>
    <Parameter name="flow" type="double" value="0.0"/>
    <Parameter name="search" type="string" value="'keff'"/>
    <Parameter name="tmod" type="double" value="565"/>
    <Parameter name="tfuel" type="double" value="565"/>
    <ParameterList name="boron">
      <Parameter name="boron.0" type="double" value="1300"/>
      <Parameter name="boron.1" type="string" value="MOD"/>
    </ParameterList>
    <Parameter name="xenon" type="string" value="none"/>
  </ParameterList>
  <ParameterList name="CORE">
    <ParameterList name="size">
      <Parameter name="size.0" type="double" value="1"/>
      <Parameter name="size.1" type="double" value="1"/>
    </ParameterList>
    <Parameter name="apitch" type="double" value="1.260"/>
    <ParameterList name="rated">
      <Parameter name="rated.0" type="double" value="17.673"/>
      <Parameter name="rated.1" type="double" value="557.7"/>
      <Parameter name="rated.2" type="double" value="2500"/>
      <Parameter name="rated.3" type="double" value="0.75"/>
    </ParameterList>
    <Parameter name="boundary" type="string" value="reflect"/>
  </ParameterList>
  <ParameterList name="ASSEMBLY">
    <Parameter name="title" type="string" value="&quot;Westinghouse VANTAGE-5H Fuel Pin&quot;&#10;"/>
    <Parameter name="pitch" type="double" value="1.260"/>
    <ParameterList name="uo2">
      <Parameter name="uo2.0" type="double" value="1"/>
      <Parameter name="uo2.1" type="string" value="U21"/>
      <Parameter name="uo2.2" type="double" value="10.257"/>
      <Parameter name="uo2.3" type="double" value="2.110"/>
    </ParameterList>
    <ParameterList name="cell">
      <Parameter name="cell.0" type="double" value="1"/>
      <Parameter name="cell.1" type="string" value="U21"/>
      <Parameter name="cell.2" type="double" value="0.4096"/>
      <Parameter name="cell.3" type="double" value="0.418"/>
      <Parameter name="cell.4" type="double" value="0.475"/>
      <Parameter name="cell.5" type="string" value="U21"/>
      <Parameter name="cell.6" type="string" value="AIR"/>
      <Parameter name="cell.7" type="string" value="ZR4"/>
    </ParameterList>
    <ParameterList name="lattice">
      <ParameterList name="row">
        <Parameter name="rowNumber" type="int" value="0"/>
        <Parameter name="rowData" type="Array(string)" value="{1,1}"/>
      </ParameterList>
    </ParameterList>
  </ParameterList>
  <ParameterList name="DENOVO">
    <Parameter name="mesh" type="double" value="10"/>
    <ParameterList name="conv_crit">
      <Parameter name="conv_crit.0" type="double" value="1e-5"/>
      <Parameter name="conv_crit.1" type="double" value="1e-4"/>
    </ParameterList>
  </ParameterList>
</ParameterList>
