[CASEID]
  title 'Seabrook 5x5 rod problem HFP'
!================================================================================
!  Sample input for DNB runs
!
!  To process:
!     ./react2xml.pl small_5x5rod_HFP.inp small_5x5rod_HFP.xml
!
!================================================================================

[STATE]
  power  100.0         ! %
  tinlet 558.8 F         ! F
  boron  1362          ! ppmB
  pressure 2250        ! psia

! tfuel  600.0         ! K - 600K  Not used with T/H feedback!
! modden 0.743         ! g/cc      Not used with T/H feedback!
  
  feedback on

  deplete GWDMT 0.0, 100.0, 200.0, 300.0, 400.0, 500.0, 600.0, 700.0, 800.0, 900.0, 1000.0, 1100.0, 1200.0

[CORE]
  size 1                    ! 1x1 single-assembly

! ****
! **** Power
! ****    For Watts Bar, 8 heated rods should have a nominal power of 1.2576 MW
! ****    I set to 0.3 MW to match Rod's input
! ****    Note that this is nominal power, may want to set a little higher
! **** Flow
! ****    For Watts Bar, 9 rods should have a flow of 0.02125 Mlb/hr
! ****    I used 0.0107857 to match Rod's input
! ****
  rated 1.60669     0.062697   ! MW, Mlbs/hr
  apitch 6.2992              ! 5 pins x 1.26 cm, +gap
  height 421.8076

  core_shape
    1
  
  assm_map
    A1

  lower_plate ss 5.0 0.5   ! mat, thickness, vol frac
  upper_plate ss 7.6 0.5   ! mat, thickness, vol frac

  bc_rad reflecting

  mat he     0.000176
  mat inc    8.20
  mat ss     8.0
  mat zirc   6.55
  mat aic   10.20
  mat pyrex  2.23
  mat b4c    6.56

[ASSEMBLY]
  title "5x5 Rod Assembly"
  npin 5
  ppitch 1.25984
  
  fuel U48 10.351 95.60 / 4.802 U-234=0.046 U-236=0.001

!=== material label, key_name, density
  mat he    0.000176
  mat inc   8.20
  mat ss    8.0
  mat zirc  6.55 

  cell 1     0.409575 0.41783 0.47498   / U48 he zirc       ! fuel rod
  cell 2              0.56134 0.60198   / mod    zirc       ! instrument tube
  cell 7              0.41783 0.47498   / mod    mod        ! empty location
  cell 8              0.41783 0.47498   /     he zirc       ! plenum
  cell 9                      0.47498   /        zirc       ! pincap
  
  lattice FUEL1
      2
      1 1
      1 1 1

  lattice LGAP1
      2
      7 7
      7 7 7

  lattice PLEN1
      2
      8 8
      8 8 8

  lattice PCAP1
      2
      9 9
      9 9 9

!  Note: active fuel = 365.76cm = 12ft = 376.0749 - 10.3149

  axial A1    6.0528
      LGAP1   8.8468
      PCAP1  10.3149
      FUEL1 376.0749
      PLEN1 395.5931
      PCAP1 396.5931
      PCAP1 399.3871

! grid masses reduced for small problem

  grid END inc  63.700 3.866    ! material, mass, height (cm)
  grid MID zirc 77.066 3.810

  grid_axial     ! centerline elevations
      END  12.8880
      MID  75.1840
      MID 127.3810
      MID 179.5780
      MID 231.7750
      MID 283.9720
      MID 336.1690
      END 388.2111

! nozzle masses reduced by (3.80/21.50)^2

  lower_nozzle  ss 6.053 600.0   ! mat, height, mass (g)
  upper_nozzle  ss 8.827 600.0   ! mat, height, mass (g)

[EDITS]

!  3in intervals in active fuel + grid
  axial_edit_bounds 
          10.3149
          10.9550
          14.8210
          22.441
          30.061
          37.681
          45.301
          52.921
          60.541
