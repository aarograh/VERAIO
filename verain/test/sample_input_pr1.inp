[CASEID]
  title CASL Westinghouse Pin Cell - Public - Rev. 0
!-----------------------------------------------------------------------
! This sample input file contains all the information needed
! to accurately model a fuel lattice
!
! This input assumes that some standard materials are predefined:
!  AIR - air for helium gap
!  ZR4 - zircaloy-4
!  MOD - water with boron
!
! This is more input than is really needed for a pin cell.  We need to
! figure out how to make this input span the space of pin->core
!
! many of the 'core' parameters may need to default
!
! **********************************************************************************
! **********************************************************************************
! ********** ERROR: This is an old style input deck and no longer works ************
! **********************************************************************************
! **********************************************************************************
!
!-----------------------------------------------------------------------
[STATE]
  power 0.0                             ! current % of rated power
  flow  0.0                             ! current % of rated flow
  search 'keff'                         ! search for critical boron with k=1.0
  tmod 565                              ! may be optional (otherwise t_in)
  tfuel 565                             ! optional (otherwise t_in)
  boron 1300 MOD                        ! set boron instead of search 
  xenon none                            ! use no short term fission product poisons
  
[CORE]
  size 1 1                              ! number of assemblies across the core and pins across each assembly
  apitch 1.260                          ! assembly pitch(cm)
  rated 17.673 557.7 2500 0.75          ! power(MW), t_in(F), p_exit(psia), mdot(Mlbs/hr) 
  boundary reflect                      ! somehow specify boundary conditions or have a 'lattice' flag

[ASSEMBLY]
  title "Westinghouse VANTAGE-5H Fuel Pin"            
  pitch  1.260                                          ! pin pitch for lattice
  uo2    1 U21 10.257 / 2.110                           ! 2.110% u235
  cell 1 U21  0.4096 0.418 0.475 / U21 AIR ZR4          ! low enriched pin cell
  lattice 1 1                                           ! lattice with 1 pin

[DENOVO]
  mesh 10                                       ! number of mesh cells per fuel rod (should have defaults)
  conv_crit 1e-5 1e-4                           ! convergence criteria  (should have defaults)
