          205.7
          213.765
          221.83
          229.895
          233.705
          241.77
          249.835
          257.9
          265.965
          274.03
          282.095
          285.905
          293.97
          302.035
          310.1
          318.165
          326.23
          334.295
          338.105
          346.0262
          353.9474
          361.8686
          369.7898
          377.711