[ASSEMBLY]
  fuel   1   10.40 95.0   / 1.60
  fuel   2   10.40 95.0   / 2.80
  fuel   3   10.40 95.0   / 3.20
  fuel   4   10.40 95.0   / 3.60
  fuel   5   10.40 95.0   / 3.95
  fuel   5G  10.19 95.0   / 3.95 / gad=8.0
  fuel   6   10.40 95.0   / 4.40
  fuel   6H  10.19 95.0   / 4.40 / gad=6.0
  fuel   6K  10.19 95.0   / 4.40 / gad=3.0
  fuel   7   10.40 95.0   / 4.90
  fuel   7G  10.19 95.0   / 4.90 / gad=8.0
  fuel   7H  10.19 95.0   / 4.90 / gad=6.0
  fuel   N   10.40 95.0   / 0.71

  ppitch 1.3
  mat zr4  6.56 zirc4
  mat zr2  6.56 zirc2

  cell  1 0.438 0.447 0.515  /   1 he zr2
  cell  2 0.438 0.447 0.515  /   2 he zr2
  cell  3 0.438 0.447 0.515  /   3 he zr2
  cell  4 0.438 0.447 0.515  /   4 he zr2
  cell  5 0.438 0.447 0.515  /   5 he zr2
  cell 5G 0.438 0.447 0.515  /  5G he zr2
  cell  6 0.438 0.447 0.515  /   6 he zr2
  cell 6H 0.438 0.447 0.515  /  6H he zr2
  cell 6K 0.438 0.447 0.515  /  6K he zr2
  cell  7 0.438 0.447 0.515  /   7 he zr2
  cell 7G 0.438 0.447 0.515  /  7G he zr2
  cell 7H 0.438 0.447 0.515  /  7H he zr2
  cell  N 0.438 0.447 0.515  /   N he zr2

  cell  E       0.447 0.515  /     he zr2
  cell  P       0.447 0.515  /     he zr2
  cell  V             0.515  /    mod
  cell WR 1.170 1.245        /    mod zr2 / large4
  npin  10

  gap    0.7549 0.7549            ! wide and narrow

  channel_box  zr4 0.1651 0.9652

  rodmap PSZ
     1
     2  2
     3  3 6K
     5  5  6 7G
     5  4 7H  5  7
     5 5G  6 WR WR  7
     5  5 6H WR WR  7  7
     5 6H  6  7  7  7 7G  7
     5  5 6H  7  7 7G  7 7G  7
     2  5  7  7  7  7  7  7  7  3

  axial 1 0.0 PSZ 1.0 
  rpdlm 1 13.0 13.4 15.0 14.0 25.0 8.0 65.0 5.0

[CONTROL]
  title "GE OEM Control Blade"
  npin 10

  mat ss304  7.41479 ss
  mat bwrb4c 1.764   b4c  ! ** check for 70% theoretical density

  cell TUBE 0.17526 0.23876 / bwrb4c ss304
  cell SS   0.17526 0.23876 / ss304  ss304

!                  span    thick  tipRad  thicksheath winglen
  bladegeom  OEM  12.3825 0.79248 0.39624   0.14224   1.98501

  bladetype  rodlets  OEM ss304 21   TUBE mod   vert
  bladetype  follower OEM ss304 21   SS   ss304 vert
  axial o   0.0 rodlets 1.0
  axial m   0.0 rodlets 1.0
  axial w   0.0 rodlets 1.0
  stroke  1.0 48

[DETECTOR]
  title "Incore instrument thimble"
  npin 1

  cell 1  0.8128 0.889 / mod ss
  cell 2         0.889 /     mod

  rodmap  LAT1
     1

  rodmap  LAT2
     2

  axial n 0.0 LAT1 1.0
  axial g 0.0 LAT1 1.0
  axial b 0.0 LAT2 1.0

[EDITS]
  axial_edit_bounds
      0.0 1.0

[MPACT]
  include MPACT.ini
  vis_edits fsrvtu
  num_space     1

[COBRATF]
  parallel       0
