[CASEID]
  title 'CASL Short Test Case'
!================================================================================
!  TRhis is a very small test case meant to run very quickly
!
!    * no grids
!    * core height is only 40 cm
!    * no transport is performed because of do_transport=false flag
!    * the number of coupled iterations is set to 1
!
!================================================================================

[STATE]
  power  100.0         ! %
  tinlet 559.0 F         ! F
  boron   600          ! ppmB
  pressure 2250        ! psia

  tfuel 900.0 K         ! K - 600K  Not used with T/H feedback! set to 900K with feedback
  modden 0.743         ! g/cc      Not used with T/H feedback!

  feedback on
  sym full

[CORE]
  size 1                  ! 1x1 single-assembly
  rated 0.01     0.00260  ! MW, Mlbs/hr  *** scaled to 1x1, increased flow to match 17x17 outlet conditions
  apitch 1.270            ! *** scaled to 1x1, no gap but larger flow area
  height  80.567

  core_shape
    1

  assm_map
    A1

  lower_plate ss 5.0 0.5   ! mat, thickness, vol frac
  upper_plate ss 7.6 0.5   ! mat, thickness, vol frac
  lower_ref   mod 26.0 1.0
  upper_ref   mod 25.0 1.0

  bc_rad reflecting

  mat he     0.000176
  mat inc    8.19
  mat ss     8.0
  mat zirc   6.56 zirc4
  mat aic   10.20
  mat pyrex  2.23
  mat b4c    6.56

[ASSEMBLY]
  title "Westinghouse 17x17"
  npin 1        ! *** scaled to 1x1
  ppitch 1.270  ! *** increased for 1x1 to get rid of gap

  fuel U31 10.257 95.0 / 3.1

  cell 1     0.4096 0.418 0.475 / U31 he zirc
  cell 100          0.561 0.602 / mod    zirc       ! guide tube
  cell 200          0.561 0.602 / mod    zirc       ! instrument tube
  cell 7            0.418 0.475 / mod    mod        ! empty location
  cell 8            0.418 0.475 /     he zirc       ! plenum
  cell 9                  0.475 /        zirc       ! pincap

  lattice FUEL1
     1

  lattice LGAP1
     7

  lattice PLEN1
     8

  lattice PCAP1
     9

  axial A1    6.050
      LGAP1  10.280
      PCAP1  11.950
      FUEL1  51.950
      PLEN1  67.950
      PCAP1  69.620
      LGAP1  71.740

  lower_nozzle  ss 6.05  21.626  ! mat, height, mass (g)  *** mass scaled to 1x1
  upper_nozzle  ss 8.827 21.626  ! mat, height, mass (g)  *** mass scaled to 1x1

[EDITS]

!  3in intervals in active fuel
  axial_edit_bounds
          11.95
          19.95
          27.95
          35.95
          43.95
          51.95

[INSILICO]
    mat_library casl_comp_r2.sh5
    xs_library  v7-252

    max_delta_z   2.54
    num_blocks_i  1
    num_blocks_j  1
    num_z_blocks  12
    num_groups    23
    num_sets      1

    do_transport  false

    mesh          4
    dimension     3
    eq_set        sc
    eigen_solver  arnoldi
    tolerance     1e-6
    Pn_order      0

!   eigenvalue_db:
       k_tolerance   1e-5
       L2_tolerance  1e-5
       energy_dep_ev true

!   quadrature_db:
       quad_type          qr
       azimuthals_octant  4
       polars_octant      4

!   silo_db:
       silo_output  p6
!      silo_out_power true

!   upscatter_db:
       upscatter_tolerance  1e-4

    new_grp_bounds
       8.2085e+05
       1.1109e+05
       5.5308e+03
       1.8644e+02
       3.7612e+01
       3.5379e+01
       2.7697e+01
       2.1684e+01
       2.0397e+01
       1.5968e+01
       7.1500e+00
       6.7000e+00
       6.3000e+00
       1.0970e+00
       1.0450e+00
       9.5000e-01
       3.5000e-01
       2.0600e-01
       1.0700e-01
       5.8000e-02
       2.5000e-02
       1.0000e-02
       1.0000e-05

[COBRATF]
  nfuel   3             ! number of fuel rings in conduction model
  nc      1             ! conduction option - radial conduction
  irfc    2             ! friction factor correlation default=2
  dhfrac  0.02          ! fraction of power deposited directly into coolant
  hgap    5678.3        ! gap conductance
  epso    0.001
  oitmax  5
  iitmax  40
  dtmin   0.000001
  dtmax   0.1
  tend    0.1
  rtwfp   1000.0
  maxits  10000
  courant 0.8
  maps_filename = single_rod_HFP

[COUPLING]
  epsk        5.0 ! pcm
  rlx_power   0.5
  rlx_tfuel   1.0
  rlx_den     1.0
  maxiter     1

