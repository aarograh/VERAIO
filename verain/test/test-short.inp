[CASEID]
  title 'CASL Short Test Case'
!================================================================================
!  TRhis is a very small test case meant to run very quickly
!
!    * no grids
!    * core height is only 40 cm
!    * no transport is performed because of do_transport=false flag
!    * the number of coupled iterations is set to 1
!
!================================================================================

!===============================================================================
!> @beginreq
!> - The VERAIn package shall be able to parse a single 3D fuel pin at
!> HFP in full symmetry with a shortened height.
!> @endreq
!===============================================================================

[STATE]
  power  100.0         ! %
  tinlet 559.0 F         ! F
  boron   600          ! ppmB
  pressure 2250        ! psia

  tfuel 900.0 K         ! K - 600K  Not used with T/H feedback! set to 900K with feedback
  modden 0.743         ! g/cc      Not used with T/H feedback!

  feedback on
  sym full

[CORE]
  size 1                  ! 1x1 single-assembly
  rated 0.01     0.00260  ! MW, Mlbs/hr  *** scaled to 1x1, increased flow to match 17x17 outlet conditions
  apitch 1.270            ! *** scaled to 1x1, no gap but larger flow area
  height  80.567

  core_shape
    1

  assm_map
    A1

  lower_plate ss 5.0 0.5   ! mat, thickness, vol frac
  upper_plate ss 7.6 0.5   ! mat, thickness, vol frac
  lower_ref   mod 26.0 1.0
  upper_ref   mod 25.0 1.0

  bc_rad reflecting

  ! add material definitions for he, inc, ss, and zirc4.
  include casl_comp_r3_full.ini

[ASSEMBLY]
  title "Westinghouse 17x17"
  npin 1        ! *** scaled to 1x1
  ppitch 1.270  ! *** increased for 1x1 to get rid of gap

  fuel U31 10.257 95.0 / 3.1

  cell 1     0.4096 0.418 0.475 / U31 he zirc4
  cell 100          0.561 0.602 / mod    zirc4       ! guide tube
  cell 200          0.561 0.602 / mod    zirc4       ! instrument tube
  cell 7            0.418 0.475 / mod    mod         ! empty location
  cell 8            0.418 0.475 /     he zirc4       ! plenum
  cell 9                  0.475 /        zirc4       ! pincap

  lattice FUEL1
     1

  lattice LGAP1
     7

  lattice PLEN1
     8

  lattice PCAP1
     9

  axial A1    6.050
      LGAP1  10.280
      PCAP1  11.950
      FUEL1  51.950
      PLEN1  67.950
      PCAP1  69.620
      LGAP1  71.740

  lower_nozzle  ss 6.05  21.626  ! mat, height, mass (g)  *** mass scaled to 1x1
  upper_nozzle  ss 8.827 21.626  ! mat, height, mass (g)  *** mass scaled to 1x1

[EDITS]

!  3in intervals in active fuel
  axial_edit_bounds
          11.95
          19.95
          27.95
          35.95
          43.95
          51.95

[COBRATF]
  nfuel   3             ! number of fuel rings in conduction model
  nc      1             ! conduction option - radial conduction
  irfc    2             ! friction factor correlation default=2
  hgap    5678.3        ! gap conductance
  epso    0.001
  iitmax  40
  dtmin   0.000001
  dtmax   0.1
  rtwfp   1000.0
  maxits  10000
  courant 0.8

[COUPLING]
  dhfrac  0.02          ! fraction of power deposited directly into coolant
  epsk        5.0 ! pcm
  rlx_power   0.5
  rlx_tfuel   1.0
  rlx_den     1.0
  maxiter     1

