      326.23
      334.295
      338.105
      346.0262
      353.9474
      361.8686
      369.7898
      377.711

[COBRATF]
  nfuel   8             ! number of fuel rings in conduction model
  nc      1             ! conduction option - radial conduction
  irfc    2             ! friction factor correlation default=2
  hgap    5678.3        ! gap conductance
  epso    0.001
  iitmax  40
  dtmin   0.000001
  dtmax   0.1
  rtwfp   1000.0
  maxits  10000
  courant 0.8
  parallel 1

[COUPLING]
  dhfrac  0.0           ! fraction of power deposited directly into coolant
  epsk        5.0  ! pcm
  epsp        1.0e-4
  rlx_power   0.6
  rlx_tfuel   1.0
  rlx_den     1.0
  maxiter     100
! read_restart cobra_denovo_restart.out

[MPACT]
  multilevel      energy
  subgrid_spacers false
