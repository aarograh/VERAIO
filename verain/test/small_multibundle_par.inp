[CASEID]
  title '5 3x3 bundle cross, modeled qtr symmetry, using parallel cobra'

[STATE]
  power   10.0         ! %
  tinlet 559.0 F         ! F
  boron  1300          ! ppmB
  pressure 2250        ! psia

  tfuel 900.0 K         ! K - 600K  Not used with T/H feedback! set to 900K with feedback
  modden 0.743         ! g/cc      Not used with T/H feedback!

  feedback on
  sym qtr

[CORE]
  size 3                 ! 3x3 cross - 5 assemblies
  rated 2.67725  0.10625 ! MW, Mlbs/hr  *** scaled to 3x3 rods - 5 assemblies
  apitch 3.86            ! *** scaled to 3x3 rods + gap
  height 406.328

  core_shape
    0 1 0
    1 1 1
    0 1 0

  assm_map
       A1   
    A1 A1 A1
       A1   

  ! add material definitions for he, inc, ss, and zirc4.
  include casl_comp_r3_full.ini

  lower_plate ss 5.0 0.5   ! mat, thickness, vol frac
  upper_plate ss 7.6 0.5   ! mat, thickness, vol frac
  lower_ref   mod 26.0 1.0
  upper_ref   mod 25.0 1.0

  bc_rad reflecting

[ASSEMBLY]
  title "Westinghouse 17x17"
  npin 3    ! *** scaled to 3x3 rods
  ppitch 1.260

  fuel U31 10.257 95.0 / 3.1

  cell 1     0.4096 0.418 0.475 / U31 he zirc4
  cell 100          0.561 0.602 / mod    zirc4       ! guide tube
  cell 200          0.561 0.602 / mod    zirc4       ! instrument tube
  cell 7            0.418 0.475 / mod    mod         ! empty location
  cell 8            0.418 0.475 /     he zirc4       ! plenum
  cell 9                  0.475 /        zirc4       ! pincap

  lattice FUEL1
     200
       1 1

  lattice LGAP1
     200
       7 7

  lattice PLEN1
     200
       8 8

  lattice PCAP1
     200
       9 9

  axial A1    6.050
      LGAP1  10.281
      PCAP1  11.951
      FUEL1 377.711
      PLEN1 393.711
      PCAP1 395.381
      LGAP1 397.501

  grid END inc   3.866  31.67  0.9070 ! height (cm), mass (g), loss coef  *** scaled to 3x3
  grid MID zirc4 3.810  27.25  0.9065 ! height (cm), mass (g), loss coef  *** scaled to 3x3

  grid_axial
      END  13.884
      MID 127.4
      END 388.2

  lower_nozzle  ss 6.05  194.64  ! mat, height, mass (g)  *** mass scaled to 3x3 rods
  upper_nozzle  ss 8.827 194.64  ! mat, height, mass (g)  *** mass scaled to 3x3 rods

[EDITS]

  axial_edit_bounds
          11.951
          15.817
          125.495
          129.305
          377.711

[INSILICO]
    xs_library  test-8grp

    max_delta_z   500.
    num_blocks_i  2
    num_blocks_j  2
    num_z_blocks  1
    num_groups    8
    num_sets      1

    mesh          1
    dimension     3
    eq_set        spn_fv
    eigen_solver  arnoldi
    tolerance     1e-9
    Pn_order      0

!   eigenvalue_db:
       k_tolerance   1e-4
       L2_tolerance  1e-4
       energy_dep_ev true

!   quadrature_db:
       quad_type          qr
       azimuthals_octant  4
       polars_octant      4

!   silo_db:
       silo_output  p6
!      silo_out_power true

!   upscatter_db:
       upscatter_tolerance  1e-4

[COBRATF]
  nfuel   3             ! number of fuel rings in conduction model
  nc      1             ! conduction option - radial conduction
  irfc    2             ! friction factor correlation default=2
  dhfrac  0.02          ! fraction of power deposited directly into coolant
  hgap    5678.3        ! gap conductance
  epso    0.0001
  oitmax  15
  iitmax  80
  dtmin   0.000001
  dtmax   0.1
  tend    0.1
  rtwfp   1000.0
  maxits  100000
  courant 0.8
! maps_filename = single_rod_HFP
  global_energy_balance    0.001 !%
  global_mass_balance      0.00003 !%
  fluid_energy_storage     0.05  !%
  solid_energy_storage     0.02  !%
  mass_storage             0.05  !%
  parallel 1

[COUPLING]
  read_restart cobra_denovo_restart.out  ! generated when run the first time.
  epsk        2.0  ! pcm
  epsp        0.002 ! with relaxation of 0.5, makes a convergence of 1e-3.
  eps_boron   2.0  ! boron convergence (ppm)
  rlx_power   0.5
  rlx_tfuel   1.0
  rlx_den     1.0
  maxiter     20


