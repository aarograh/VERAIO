[CASEID]
  title 'CASL Problem Singlerod HFP'
!================================================================================
!  Sample input for small singlerod Problem
!
!  Updated 3/18/2013 to be consistent with Problem 6 T/H
!
!  To process:
!     ./react2xml.pl [file].inp [file].xml
!
!================================================================================

!===============================================================================
!> @beginreq
!> - The VERAIn package shall be able to parse a single 3D fuel pin at
!> HFP in full symmetry
!> @endreq
!===============================================================================

[STATE]
  power  100.0         ! %
  tinlet 559.0 F         ! F
  boron  1300          ! ppmB
  pressure 2250        ! psia

  tfuel 900.0 K         ! K - 600K  Not used with T/H feedback! set to 900K with feedback
  modden 0.743         ! g/cc      Not used with T/H feedback!

  feedback on
  sym full

[CORE]
  size 1                ! 1x1 single-assembly
  rated 0.066932 0.00260  ! MW, Mlbs/hr  *** scaled to 1x1, increased flow to match 17x17 outlet conditions
  apitch 1.270            ! *** scaled to 1x1, no gap but larger flow area
  height 406.328

  core_shape
    1

  assm_map
    A1

  lower_plate ss 5.0 0.5   ! mat, thickness, vol frac
  upper_plate ss 7.6 0.5   ! mat, thickness, vol frac
  lower_ref   mod 26.0 1.0
  upper_ref   mod 25.0 1.0

  bc_rad reflecting

  mat he     0.000176
  mat inc    8.19
  mat ss     8.0
  mat zirc   6.56 zirc4
  mat aic   10.20
  mat pyrex  2.23
  mat b4c    6.56

[ASSEMBLY]
  title "Westinghouse 17x17"
  npin 1        ! *** scaled to 1x1
  ppitch 1.270  ! *** increased for 1x1 to get rid of gap

  fuel U31 10.257 95.0 / 3.1

  cell 1     0.4096 0.418 0.475 / U31 he zirc
  cell 100          0.561 0.602 / mod    zirc       ! guide tube
  cell 200          0.561 0.602 / mod    zirc       ! instrument tube
  cell 7            0.418 0.475 / mod    mod        ! empty location
  cell 8            0.418 0.475 /     he zirc       ! plenum
  cell 9                  0.475 /        zirc       ! pincap

  lattice FUEL1
     1

  lattice LGAP1
     7

  lattice PLEN1
     8

  lattice PCAP1
     9

  axial A1    6.050
      LGAP1  10.281
      PCAP1  11.951
      FUEL1 377.711
      PLEN1 393.711
      PCAP1 395.381
      LGAP1 397.501

  grid END inc 3.866 3.519 / loss=0.9070 ! grid height (cm), mass (g), loss coef *** mass scaled to 1x1 rod
  grid MID zirc 3.810 3.028 / loss=0.9065 ! grid height (cm), mass (g), loss coef *** mass scaled to 1x1 rod

  grid_axial
      END  13.884
      MID  75.2
      MID 127.4
      MID 179.6
      MID 231.8
      MID 284.0
      MID 336.2
      END 388.2

  lower_nozzle  ss 6.05  21.626  ! mat, height, mass (g)  *** mass scaled to 1x1
  upper_nozzle  ss 8.827 21.626  ! mat, height, mass (g)  *** mass scaled to 1x1

[EDITS]

!  3in intervals in active fuel
  axial_edit_bounds
          11.951
          15.817
          24.028
          32.239
          40.45
          48.662
          56.873
          65.084
          73.295
          77.105
          85.17
          93.235
          101.3
          109.365
          117.43
          125.495
          129.305
          137.37
          145.435
          153.5
          161.565
          169.63
          177.695
          181.505
          189.57
          197.635
          205.7
          213.765
          221.83
          229.895
          233.705
          241.77
          249.835
          257.9
          265.965
          274.03
          282.095
          285.905
          293.97
          302.035
          310.1
          318.165
          326.23
          334.295
          338.105
          346.0262
          353.9474
          361.8686
          369.7898
          377.711

[COBRATF]
  nfuel   3             ! number of fuel rings in conduction model
  nc      1             ! conduction option - radial conduction
  irfc    2             ! friction factor correlation default=2
  chf     3
  hgap    5678.3        ! gap conductance
  edit_channels 1
  parallel 0
  ! Following is not used in this simulation, but just here for testing
  cicada_outer_radial_zone_num_cells_r 10
  cicada_inner_radial_zone_num_cells_r 20
  cicada_outer_radial_zone_thickness 80.0e-6
  cicada_dimensions 3
  enable_corrosion_lithium 0
  property_evaluations asme1968
  crud_boil_coeff_model 1



[COUPLING]
  dhfrac  0.02          ! fraction of power deposited directly into coolant
  epsk        5.0  ! pcm
  eps_temp    1.0  ! temperature convergence in C
  rlx_power   0.5
  rlx_tfuel   1.0
  rlx_den     1.0
  maxiter     100

