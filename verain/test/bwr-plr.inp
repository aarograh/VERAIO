! dimension refs
! Ref. 1: Spent nuclear fuel for disposal in the KBS-3 Repository,
!         TR-10-13, Svensk Kärnbränslehantering AB,
!         https://skb.se/upload/publications/pdf/tr-10-13.pdf
! Ref. 2: UK ABWR Generic Design Assessment, GE Hitachi, SE-GD-0136
!         http://www.hitachi-hgne-uk-abwr.co.uk/downloads/2017-12-14/UKABWR-GA91-9101-0101-11000-RevC-PB.pdf
! Ref. 3: Optimum Boiling Water Reactor Fuel Design Strategies to 
!         Enhance Reactor Shutdown by the Standby Liquid Control 
!         System, Michael Fensin, UF thesis 2004.
!         http://etd.fcla.edu/UF/UFE0005364/fensin_m.pdf
! Ref. 4: BWR TT Benchmark Final Specifications (Feb. 2001)
!         https://www.oecd-nea.org/science/docs/2001/nsc-doc2001-1.pdf
! Ref. 5: Depletion of a BWR Lattice Using the RACER Continuous Energy Monte Carlo Code
!         Proc. Int. Conf. on Math and Comp. Reactor Physics, and Env. Analysis,
!         Portland, Oregon, USA, April 30-May 4 (1995)


! Some general info for BWR
!  3926 MWth        Ref. 2
!  872 Assms        Ref. 2
!  115.08012 Mlb/h  Ref. 2


!===============================================================================
!> @beginreq
!> - The VERAIn package shall be able to parse the default material name 'cool'
!> - ticket 4306
!> @endreq
!===============================================================================

[CASEID]
  title '10x10 Lattice HFP 0.0% void'

[STATE]
  power               100.0
  tinlet              600.0 K 
  tfuel               900.0 K 
  pressure             1040 ! psia Ref. 2
  sym                  full
  feedback              off
  void                 80.0
  
  
[CORE]
  reactor_type          BWR
  size                    1
  apitch              15.24 ! for BWR (Ref. 2 has this as the pitch for BWR5 assemblies)
  height                1.0
  rated           0.0122 0.01 ! estimate using ABWR data assume 10% bypass flow
  core_shape       
      1
  assm_map       
     ASSY1
  bc_rad         reflecting
  bc_top         reflecting
  bc_bot         reflecting
  mat            zr2 6.56 zirc2
  mat            zr4 6.56 zirc4
  mat he   0.000176 he-4


[ASSEMBLY]
  title "GE14 (best estimate) lattice"
  npin                   10
  ppitch                1.3 ! Ref. 1
  gap            0.7549 0.7549 ! C lattice with 65 mil channel box and 13.4 cm internal channel box dim from ref. 1
  channel_box    zr4 0.1651 0.9652 ! thickness from Ref. 1 (rounded up by 0.0001 to be 65 mils), radius from old 80 mil design (Ref. 5)


  fuel           U16  10.4  94.5 / 1.6     ! non gad fuel density from Table A-3 in Ref 1
  fuel           U28  10.4  94.5 / 2.8
  fuel           U32  10.4  94.5 / 3.2
  fuel           U36  10.4  94.5 / 3.6
  fuel           U40  10.4  94.5 / 3.95
  fuel           U44  10.4  94.5 / 4.4
  fuel           U49  10.4  94.5 / 4.9

! gad pin density estimated using Ref. 4

  fuel           U40G8 10.19  94.5 / 3.95 / gad=8.0 
  fuel           U44G6 10.19  94.5 / 4.4  / gad=6.0
  fuel           U44G3 10.19  94.5 / 4.4  / gad=3.0 
  fuel           U49G8 10.19  94.5 / 4.9  / gad=8.0
  fuel           U49G6 10.19  94.5 / 4.9  / gad=6.0

  ! pin dimensions from ref 1
  cell           1  0.438 0.447 0.515 / U16   he zr2
  cell           2  0.438 0.447 0.515 / U28   he zr2
  cell           3  0.438 0.447 0.515 / U32   he zr2
  cell           4  0.438 0.447 0.515 / U36   he zr2
  cell           5  0.438 0.447 0.515 / U40   he zr2
  cell           6  0.438 0.447 0.515 / U44   he zr2
  cell           7  0.438 0.447 0.515 / U49   he zr2
  cell           5G 0.438 0.447 0.515 / U40G8 he zr2
  cell           6H 0.438 0.447 0.515 / U44G6 he zr2
  cell           7G 0.438 0.447 0.515 / U49G8 he zr2
  cell           7H 0.438 0.447 0.515 / U49G6 he zr2
  cell           6K 0.438 0.447 0.515 / U44G3 he zr2
  ! vanished rod
  cell           V              0.515 / cool
  ! WR dims from ref 1
  cell           WR 1.17 1.245 / mod zr4 / large4




  
  lattice        LAT

  ! pattern from ref. 3 VAN region
    1
    2  V
    3  3  6
    5  V  6   7G
    5  4  7H  5  V
    5  5  6   WR WR V
    5  V  6H  WR WR 7G 7
    5  6H 6   7  7  7  7  7
    5  V  6H  V  7  7G V  7G V
    2  5  7   7  7  7  7  7  7  3 



  axial          ASSY1  0.0 LAT 1.0


[MPACT]
  vis_edits             fsr
  grid_treatment homogenize
  num_space               1
  num_angle              -8
  num_threads             1
  ray_spacing          0.01

  power_edit        FISSION



