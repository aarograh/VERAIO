       213.1898
       221.1110

[MPACT]
  num_space      1
  num_angle      1
  num_threads    1
  ray_spacing        0.08
  shield_ray_spacing 0.08
  azimuthals_octant 4
  shield_azimuthals_octant 4
  polars_octant     1
  xs_filename       mpact8g_70s_v4.0m0_02232015.fmt
  res_up_scatter    false
  dep_substep       1
  include bison_table_tavg_rev6.tab
  meshing_method useraxialmesh
  axial_mesh  10.000
               5.000
