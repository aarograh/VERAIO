[CASEID]
  title 'Sample 2D GE9 BWR Lattice'

!------------------------------------------------------------------------------
!
! *** Note that this input deck is not correct because we do not currently model
! *** the oversize GE11 water rod at this time
! *** The water rod in this input is smaller to fit in a pincell
!
! Geometry Reference:
! D. J. Kelly,
! "Depletion of a BWR Lattice Using the RACER Continuous Energy
!    Monte Carlo Code,â€
! Proc. Int. Conf. on Math and Comp., Reactor Physics, and Env. Analysis,
! Portland, Oregon, USA, April 30-May 4 (1995).
!------------------------------------------------------------------------------

[STATE]
  power    100.0
  tinlet   550 K  ! *** approximate
  tfuel    900 K
  pressure 1040   ! psia
  sym      full

  axial_void    0.0
         50.0 200.0
         25.0 380.0

!** at void 00,  rho=  0.736690 g/cc
!** at void 40,  rho=  0.457023 g/cc
!** at void 70,  rho=  0.247273 g/cc


[CORE]
  reactor_type BWR
  size   1
  apitch 15.24
  height 1.0
  rated  0.01 0.01   ! *** approximate

  core_shape
    1

  assm_map
    ASSY

  bc_rad reflecting
  bc_top reflecting
  bc_bot reflecting

  mat zr2  6.56 zirc2
  mat zr4  6.56 zirc4

[ASSEMBLY]
  npin   8
  ppitch 1.6256          ! pin pitch - does not include channel gaps

!*** 80 mil design
  gap    0.9525 .47498   ! wide and narrow channel gap (cm)
  channel_box  zr4 0.2032 0.9652 ! channel dimensions

!** Note that the automatic addition of U-234 does not agree with the spec
!** and we may need to add U-234 explicitly

  fuel U16  10.0642 94.5 / 1.6
  fuel U20  10.0642 94.5 / 2.0
  fuel U22  10.0642 94.5 / 2.2
  fuel U24  10.0642 94.5 / 2.4
  fuel U26  10.0642 94.5 / 2.6
  fuel U28  10.0642 94.5 / 2.8
  fuel U30  10.0642 94.5 / 3.0
  fuel U36  10.0642 94.5 / 3.6
  fuel U36G  9.939  94.5 / 3.6 / gad=4.0
  fuel U38  10.0642 94.5 / 3.8
  fuel U40  10.0642 94.5 / 3.95
  fuel U40G  9.939  94.5 / 3.95 / gad=4.0

  cell  1 0.53213 0.61341 / U16  zr2
  cell  2 0.53213 0.61341 / U20  zr2
  cell  3 0.53213 0.61341 / U22  zr2
  cell  4 0.53213 0.61341 / U24  zr2
  cell  5 0.53213 0.61341 / U26  zr2
  cell  6 0.53213 0.61341 / U28  zr2
  cell  7 0.53213 0.61341 / U30  zr2
  cell  8 0.53213 0.61341 / U36  zr2
  cell  9 0.53213 0.61341 / U38  zr2
  cell 10 0.53213 0.61341 / U40  zr2
  cell 51 0.53213 0.61341 / U40G zr2
  cell 52 0.53213 0.61341 / U36G zr2

!** water rod is smaller to fit in a pincell
!** cell WR 1.6002 1.7018 / mod zr4

  cell WR 1.60 1.62 / mod zr4 / large4
!  cell WR 1.60 1.62 / mod U40 / large4

  lattice LAT
    1
    2  6
    4  8 10
    6 10 52 WR
    6 10 10 WR WR
    6 10 51 10 10 10
    5  9 10 51 10 51 10
    3  7  9 10 10 10  9  6

  axial ASSY 0.0 LAT 1.0

[CONTROL]
  title "GE OEM Control Blade"
  npin 8
  stroke  365.76 48      ! 6in step size and 48 steps

!*** 3D BWR control blades have not been designed yet.
!*** How do we indicate control blades from bottom of core?
!*** Do we need a rodmap and axial card?

  mat ss304 8.0  ss
  mat abs   4.62 b4c  ! ** check for 70% theoretical density
!
  cell TUBE 0.17526 0.23876 / abs ss304 ! <---  same data as "cell" card, referenced by blade_type card, optional.

!            label  span   th       rad    sheath    wing
  bladegeom  OEM 12.3825 0.79248 0.39624 0.14224  1.98501  !split from old "blade" card.  Added a blade_geom label to be referenced in blade_type

!            label  geomlabel mat ntube celllabel fillermat hor/vert
  bladetype  rodlets  OEM ss304 21   TUBE mod    vert !<--- split from old "blade" card. References the blade_geom label, and blade_cell label.
  bladetype  follower OEM ss304 0    -    ss304  vert !<--- blade_cell label is "-", meaning null/not used.

  axial OEM_BLADE 0.0 rodlets 363.22 follower 365.76 !<--- The axial control blade description, references the blade_type labels.
  axial OEM_HOMOG 0.0 rodlets 365.76

[MPACT]
  num_space      1
  num_angle      1
  num_threads    1
