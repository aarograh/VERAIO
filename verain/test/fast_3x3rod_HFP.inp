[CASEID]
  title 'CASL Problem 3x3 HFP'
!================================================================================
!  Sample input for small 3x3 Problem
!
!  Updated 3/18/2013 to be consistent with Problem 6 T/H
!
!  To process:
!     ./react2xml.pl [file].inp [file].xml
!
!================================================================================

!===============================================================================
!> @beginreq
!> - The VERAIn package shall be able to parse a single 3D 3x3 assembly at HFP.
!> @endreq
!===============================================================================

[STATE]
  power  100.0         ! %
  tinlet 559.0 F         ! F
  boron  1300          ! ppmB
  pressure 2250        ! psia

  tfuel 900.0 K         ! K - 600K  Not used with T/H feedback! set to 900K with feedback
  modden 0.743         ! g/cc      Not used with T/H feedback!

  feedback on
  sym full

[CORE]
  size 1                ! 1x1 single-assembly
  rated 0.53545 0.02125 ! MW, Mlbs/hr  *** scaled to 3x3
  apitch 3.78           ! *** scaled to 3x3, no gap
  height 406.328

  core_shape
    1

  assm_map
    A1

  ! add material definitions for he, inc, ss, and zirc4.
  include casl_comp_r3_full.ini

  lower_plate ss 5.0 0.5   ! mat, thickness, vol frac
  upper_plate ss 7.6 0.5   ! mat, thickness, vol frac
  lower_ref   mod 26.0 1.0
  upper_ref   mod 25.0 1.0

  bc_rad reflecting

[ASSEMBLY]
  title "Westinghouse 17x17"
  npin 3    ! *** scaled to 3x3
  ppitch 1.260

  fuel U31 10.257 95.0 / 3.1

  cell 1     0.4096 0.418 0.475 / U31 he zirc4
  cell 100          0.561 0.602 / mod    zirc4       ! guide tube
  cell 200          0.561 0.602 / mod    zirc4       ! instrument tube
  cell 7            0.418 0.475 / mod    mod         ! empty location
  cell 8            0.418 0.475 /     he zirc4       ! plenum
  cell 9                  0.475 /        zirc4       ! pincap

  lattice FUEL1
     200
       1 1

  lattice LGAP1
     200
       7 7

  lattice PLEN1
     200
       8 8

  lattice PCAP1
     200
       9 9

  axial A1    6.050
      LGAP1  10.281
      PCAP1  11.951
      FUEL1 377.711
      PLEN1 393.711
      PCAP1 395.381
      LGAP1 397.501

  grid END inc 3.866 31.67 / loss=0.9070 ! height (cm), mass (g), loss coef *** scaled to 3x3
  grid MID zirc4 3.810 27.25 / loss=0.9065 ! height (cm), mass (g), loss coef *** scaled to 3x3

  grid_axial
      END  12.9
      MID 127.4
      END 388.2

  lower_nozzle  ss 6.05  194.64  ! mat, height, mass (g)  *** mass scaled to 3x3
  upper_nozzle  ss 8.827 194.64  ! mat, height, mass (g)  *** mass scaled to 3x3

[EDITS]

!  3in intervals in active fuel
  axial_edit_bounds
           6.05
          10.967
          14.833
          125.495
          129.305
          377.711
          386.267
          390.133
          397.5

[COBRATF]
  nfuel   3             ! number of fuel rings in conduction model
  nc      1             ! conduction option - radial conduction
  irfc    2             ! friction factor correlation default=2
  hgap    5678.3        ! gap conductance
  epso    0.001
  iitmax  40
  dtmin   0.000001
  dtmax   0.1
  rtwfp   1000.0
  maxits  1000000
  courant 0.8
  global_energy_balance    0.0001 !%
  global_mass_balance      0.0001 !%
  fluid_energy_storage     0.005  !%
  solid_energy_storage     0.005  !%
  mass_storage             0.005  !%

[COUPLING]
  dhfrac  0.02          ! fraction of power deposited directly into coolant
  epsk        2.0  ! pcm
  eps_boron   2.0  ! boron convergence (ppm)
  rlx_power   0.35
  rlx_tfuel   1.0
  rlx_den     1.0
  maxiter     20
  ctf_iters_max    200
  ctf_iters_growth 1.2

