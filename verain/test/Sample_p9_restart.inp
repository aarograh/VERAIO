[CONTROL]
  title "B4C with AIC tips"
  npin 17
  stroke  365.125 230     ! approx for 1.5875 step sizes and 230 max stroke

!  Smeared control rod into helium gap and decreased density accordingly
  mat aic 9.989696368
  mat b4c 1.643447072

  cell 1  0.386 0.484 /    aic ss
  cell 2  0.386 0.484 /    b4c ss
  cell 3  0.386 0.484 / spring ss !plenum
  cell 4  0.386 0.484 /     ss ss !plug

  rodmap AIC
     -
     - -
     - - -
     1 - - 1
     - - - - -
     - - - - - 1
     1 - - 1 - - -
     - - - - - - - -
     - - - - - - - - -

  rodmap B4C
     -
