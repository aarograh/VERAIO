[MPACT]
  vis_edits         none
  ray_spacing       0.05
  jagged            true
!quad_set
  quad_type         CHEBYSHEV-GAUSS
  polars_octant     3
  azimuthals_octant 8
!iteration_control
  flux_tolerance    1e-4
  num_inners        3
  k_tolerance       1e-6
  up_scatter        2
  num_outers        20
  scattering        P2
!cmfd
  cmfd              odcmfd
  cmfd_solver       1gsweep
  k_shift           1.15
  cmfd_num_outers   20
!2D1D
  split_TL          true
  TL_treatment      lflat
  nodal_method      nem
!  under_relax       1.0
!parallel
  num_space         2880
  num_angle         1
  num_energy        1
  num_threads       1
  par_method        GRAPH    !Use graph-based decomposition
  graph_part_method REB RSB  !
  graph_refn_method SKL
  graph_cond        500
!xs_library
  xs_filename       declib56g_e7_09042013_p0mixed.fmt
  xs_type           ORNL
  dep_filename      mpact.dpl
  subgroup_set      4
!mesh

  mesh fuel  3 1 1 / 8 8 8 8 8 8
  mesh gtube 3 1   / 8 8 8 8 8

  meshing_method    nonfuel
  automesh_bounds  2.0 20.0
