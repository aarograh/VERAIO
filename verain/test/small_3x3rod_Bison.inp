[CASEID]
  title 'CASL Problem 3x3 HFP'
!================================================================================
!  Sample input for small 3x3 Problem
!
!  Updated 3/18/2013 to be consistent with Problem 6 T/H
!
!  To process:
!     ./react2xml.pl [file].inp [file].xml
!
!================================================================================

[STATE]
  tinlet 559.0 F       ! F
  boron  1300          ! ppmB
  pressure 2250        ! psia

  tfuel 900.0 K        ! K         Not used with T/H feedback! set to 900K with feedback
  modden 0.743         ! g/cc      Not used with T/H feedback!

  feedback on
  sym full

                            power 0.00001 ! Hot Zero Power
  [STATE] deplete EFPD   1; power     100 ! Ramp to HFP in 2 days

[CORE]
  size 1                ! 1x1 single-assembly
  rated 0.53545 0.02125 ! MW, Mlbs/hr  *** scaled to 3x3
  apitch 3.78           ! *** scaled to 3x3, no gap
  height 406.328

  core_shape
    1

  assm_map
    A1

  lower_plate ss 5.0 0.5   ! mat, thickness, vol frac
  upper_plate ss 7.6 0.5   ! mat, thickness, vol frac
  lower_ref   mod 26.0 1.0
  upper_ref   mod 25.0 1.0

  bc_rad reflecting

  include CORE.ini   ! load default materials
  mat zirc   6.56 zirc4

[ASSEMBLY]
  title "Westinghouse 17x17"
  npin 3    ! *** scaled to 3x3
  ppitch 1.260

  fuel U31 10.257 94.3 / 3.1

  cell 1     0.4096 0.418 0.475 / U31 he zirc
  cell 100          0.561 0.602 / mod    zirc       ! guide tube
  cell 200          0.561 0.602 / mod    zirc       ! instrument tube
  cell 7            0.418 0.475 / mod    mod        ! empty location
  cell 8            0.418 0.475 /     he zirc       ! plenum
  cell 9                  0.475 /        zirc       ! pincap

  lattice FUEL1
     200
       1 1

  lattice LGAP1
     200
       7 7

  lattice PLEN1
     200
       8 8

  lattice PCAP1
     200
       9 9

  axial A1    6.050
      LGAP1  10.281
      PCAP1  11.951
      FUEL1 377.711
      PLEN1 393.711
      PCAP1 395.381
      LGAP1 397.501

  grid END inc 3.866 31.67 / loss=0.9070 ! height (cm), mass (g), loss coef *** scaled to 3x3
  grid MID zirc 3.810 27.25 / loss=0.9065 ! height (cm), mass (g), loss coef *** scaled to 3x3


  grid_axial
      END  13.884
      MID  75.2
      MID 127.4
      MID 179.6
      MID 231.8
      MID 284.0
      MID 336.2
      END 388.2

  lower_nozzle  ss 6.05  194.64  ! mat, height, mass (g)  *** mass scaled to 3x3
  upper_nozzle  ss 8.827 194.64  ! mat, height, mass (g)  *** mass scaled to 3x3

[EDITS]

!  3in intervals in active fuel
  axial_edit_bounds
          11.951
          15.817
          24.028
          32.239
          40.45
          48.662
          56.873
          65.084
          73.295
          77.105
          85.17
          93.235
          101.3
          109.365
          117.43
          125.495
          129.305
          137.37
          145.435
          153.5
          161.565
          169.63
          177.695
          181.505
          189.57
          197.635
          205.7
          213.765
          221.83
          229.895
          233.705
          241.77
          249.835
          257.9
          265.965
          274.03
          282.095
          285.905
          293.97
          302.035
          310.1
          318.165
          326.23
          334.295
          338.105
          346.0262
          353.9474
          361.8686
          369.7898
          377.711

[COBRATF]
  nfuel   3             ! number of fuel rings in conduction model
  nc      1             ! conduction option - radial conduction
  irfc    2             ! friction factor correlation default=2
  dhfrac  0.02          ! fraction of power deposited directly into coolant
  hgap    5678.3        ! gap conductance
  epso    0.001
  iitmax  40
  dtmin   0.000001
  dtmax   0.1
  rtwfp   1000.0
  maxits  10000
  courant 0.8

[BISON]
  executioner_start_time = -100
  solve_type tiamat_inline
  bcs_plenumpressure_plenumpressure_initial_pressure = 2.0e6
  bcs_plenumpressure_plenumpressure_startup_time = 1e4
  burnup_burnup_num_radial = 6
  burnup_burnup_num_axial = 48
  executioner_dt = 1.0e3
  executioner_end_time = 6.0e7
  globalparams_a_lower = 0.01676
  globalparams_a_upper = 3.67436
  globalparams_energy_per_fission = 3.2e-11
  mesh_clad_bot_gap_height = 1.52e-3
  outputs_file_base = output_RISO_AN8_bump
  fuel_pin_input_file_template = small_3x3rod_Bison.i.template
  non_fuel_pin_input_file_template = guide_tube.moose.i.template
  mesh_type smeared_pellet
  output_average_axial_values = true

[COUPLING]
  epsk        5.0  ! pcm
  rlx_power   0.5
  rlx_tfuel   1.0
  rlx_den     1.0
  maxiter     100

[TIAMAT]
  solver jacobi
  run_transient false
  conserve_power_in_tiamat_transfer true
  num_subcycle_iterations_before_tiamat_ramping 0
