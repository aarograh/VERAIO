[CASEID]
  title 'CE16x16 Case - New 64 Er Case'
!
!  16x16 CE design with Erbia (new erbium pattern)
!
!  Nuclear Fuel Update
!  Palo Verde Nuclear Generating Station
!  December 9, 2004
!  Meeting with US NRC
!  ML050240096.pdf
!
!  3/31/2017 - minor updates to match CASL-U-2017-1300-000
!
[STATE]
  power    0.0
  tinlet   600 K
  tfuel    900 K
  modden   0.703158   ! g/cc  den2
  boron    600        ! ppm
  sym      qtr
  feedback off

[CORE]
  size   1
  apitch 20.7772
  height 1.0
  rated  0.042324 0.01

  core_shape
    1

  assm_map
    ASSY

  bc_rad reflecting
  bc_top reflecting
  bc_bot reflecting

  include CORE.ini   ! load default materials

  mat he 0.000176 he-4
  mat zirc 6.56 zr    ! **** natural Zr, but shoudld be Zirlo

  mat erbia      8.64     er-162 1.17689E-03  ! SCALE 6.2 Er2O3
                          er-164 1.37228E-02  ! density from matweb.com
                          er-166 2.90673E-01
                          er-167 1.99610E-01
                          er-168 2.36886E-01
                          er-170 1.32482E-01
                          o-16   1.25449E-01 / thexp=7.0         ! estimate ***

[ASSEMBLY]
  npin   16
  ppitch 1.28524

  fuel UHI 10.43  96.5 / 4.29
  fuel UMD 10.43  96.5 / 3.99
  fuel ULO 10.43  96.5 / 3.79
  fuel UER 10.43  96.5 / 3.79 / erbia=2.1

  cell 1 0.41339 0.42164 0.48514 / UHI he zirc
  cell 2 0.41339 0.42164 0.48514 / UMD he zirc
  cell 3 0.41339 0.42164 0.48514 / ULO he zirc
  cell E 0.41339 0.42164 0.48514 / UER he zirc

  cell W 1.1430  1.2446 / mod zirc / large4

  lattice LAT
    W
    E 3
    1 1 E
    1 1 E W
    1 1 E W W
    1 1 E E E E
    2 2 2 2 2 2 E
    3 3 3 3 3 3 3 E

  axial ASSY 0.0 LAT 1.0

[CONTROL]
  npin   16
  stroke 1.0 1

  mat b4cp 1.84 b4c    ! powder

  cell C 0.936 0.94742 1.03632  / b4cp he inc / large4

  rodmap  LAT
    -
    - -
    - - -
    - - - C
    - - - C C
    - - - - - -
    - - - - - - -
    - - - - - - - -

  axial CC 0.0 LAT  1.0

[MPACT]
  num_space      1
  num_angle      1
  num_threads    1
  xs_filename    mpact51g_71_v4.2m5_12062016_sph.fmt


