          153.5
          161.565
          169.63
          177.695
          181.505
          189.57
          197.635
          205.7
          213.765
          221.83
          229.895
          233.705
          241.77
          249.835
          257.9
          265.965
          274.03
          282.095
          285.905
          293.97
          302.035
          310.1
          318.165
          326.23
          334.295
          338.105
          346.0262
          353.9474
          361.8686
          369.7898
          377.711

[COUPLING]
  read_restart  my_restart_file
  extend_coupling_mesh above

[TIAMAT]
  solver jacobi
  conserve_power_in_tiamat_transfer true

[COBRATF]
  nfuel   18            ! number of fuel rings in conduction model
  nc      1             ! conduction option - radial conduction
  irfc    2             ! friction factor correlation default=2
  dhfrac  0.02          ! fraction of power deposited directly into coolant
  hgap    5678.3        ! gap conductance
  epso    0.001
  iitmax  40
  dtmin   0.000001
  dtmax   0.1
  rtwfp   1000.0
  maxits  10000
  courant 0.8

[MPACT]
  sth_hgap   5200.0   ! internal t/h option
  sth_dhfrac 0.02     ! internal t/h option
  exclude_depl_mats U31 U32 b4c
  include_depl_mats U32 U33 aic he
  pin_cell_mod_mesh  3 both
  rst_compress      none !none or 0-9
  log_message debug
  rx_components false
  checkpoint_write testWrite.h5 5
  checkpoint_read testRead.h5 2
  nodal_edits true
  nodal_edits senm-2
  nodal_edits_energy_cutoff 0.625
  nodal_edits_adapt_adf true
  nodal_edits_collapse_axial_reflectors true
  dep_shielder_dt  0.01
  cmfd_linear_solver native
  cmfd_linear_solver trilinos
  cmfd_linear_solver petsc
  inter_assembly_gapmeshnum 5 5 5 5 1
  control_blade_meshnum 6 6
  detector_meshnum 6 6
  gamma_ray_spacing 0.08
  gamma_moc_kernel  1g
  gamma_quad_type   CHEBYSHEV-CHEBYSHEV
  gamma_azimuthals_octant 4
  gamma_polars_octant     1
  gamma_flux_tolerance   1e-3
  gamma_num_inners       1
  gamma_up_scatter       1
  gamma_scattering       P0
  gamma_nodal_method     nem
  nodal_inners    10
  nodal_group_loop  3
  nodal_leakage_order  1
  gamma_nodal_inners   40
  gamma_nodal_group_loop  10
  gamma_nodal_leakage_order 0
  gad_dep_method qgd2
  nodal_group_start     1
  nodal_inner_tol       1E-5
  nodal_group_tol       5E-5
  nodal_relax_negative  true
  moc_min_flux          1E-20
  split_TL_tol          0.0
  cmfd_relax_negative   true
