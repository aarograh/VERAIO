          318.165
          326.23
          334.295
          338.105
          346.0262
          353.9474
          361.8686
          369.7898
          377.711

[INSILICO]
    xs_library  test-8grp

    max_delta_z   2.54
    radial_geom_eps   1.1e-4
    axial_geom_eps    1.1e-3
    num_blocks_i  2
    num_blocks_j  2
    num_z_blocks  1
    num_groups    8
    num_sets      1

    mesh          4
    dimension     3
    eq_set        spn_fv
    Pn_order      0

!   solver_db:
       solver        arnoldi
       k_tolerance   1e-7
       tolerance     1e-6
       energy_dep_ev true

!   quadrature_db:
       quad_type          qr
       azimuthals_octant  4
       polars_octant      4

!   silo_db:
       silo_output  p6
!      silo_out_power true

!   upscatter_db:
       upscatter_tolerance  1e-4

[COUPLING]
  read_restart  my_restart_file

[TIAMAT]
  solver jacobi
  conserve_power_in_tiamat_transfer true
  two_level_solver false
  inner_solver gauss-seidel
  inner_evaluator NeutronicsCTF

[COBRATF]
  nfuel   18            ! number of fuel rings in conduction model
  nc      1             ! conduction option - radial conduction
  irfc    2             ! friction factor correlation default=2
  dhfrac  0.02          ! fraction of power deposited directly into coolant
  hgap    5678.3        ! gap conductance
  epso    0.001
  oitmax  5
  iitmax  40
  dtmin   0.000001
  dtmax   0.1
  tend    0.1
  rtwfp   1000.0
  maxits  10000
  courant 0.8

[MPACT]
  sth_hgap   5200.0   ! internal t/h option
  sth_dhfrac 0.02     ! internal t/h option
  exclude_depl_mats U31 U32 b4c
  include_depl_mats U32 U33 aic he
[BISON]
  ramp_data_transfers = true
