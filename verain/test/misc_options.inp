[CASEID]
  title 'Test Misc options'
!================================================================================
! This test case is somewhere we can test misc. options added to the input
!
! Running this case will not produce any meaningful results
!
!  To process:
!     ./react2xml.pl [file].inp [file].xml
!
!================================================================================

[STATE]
  title "Test & in input - see Story # 3279"
  power  100.0         ! %
  tinlet 559.0 F         ! F
  boron  1300          ! ppmB
  search 'boron';  kcrit  1.02
  pressure 2250   ;     ! psia

  thexp  on
  thexp_tfuel 875.0 K
  thexp_tclad 350.0 C
  thexp_tmod  559.0 F

  tfuel 900.0 K         ! K - 600K  Not used with T/H feedback! set to 900K with feedback
  modden 0.743         ! g/cc      Not used with T/H feedback!

  feedback on
  sym full

  deplete GWDMT 0.0 1.0 2.0 3.5 4.5

[STATE]
  power  80.0     ! added multistate 1/30/2014 , must use --multistate command line option

  tinlet_dist       0.    -2. 0. 2.        0. ;  flow_dist          20.    -20.  0  20         -20.


[STATE];  power  70.0

[STATE]  power  60.0;   tinlet_dist       2. -1.       -1.

! This map is not rotationally symmetric
!  flow_dist
!     50. -20.5
!    -10.

  flow_dist
     50. -10.
    -10.

[STATE];  power  50.0
[STATE];  power  40.0
[STATE]  power  30.0
[STATE];  power  20.0 ; [STATE]  power  10.0

[CORE]
  size 3                ! 3x3 cross - 5 assemblies
  rated 2.67725  0.10625 ! MW, Mlbs/hr  *** scaled to 3x3 5 assemblies
  apitch 3.78           ! *** scaled to 3x3, no gap
  height 406.328

  core_shape
    0 1 0
    1 1 1
    0 1 0

  assm_map
       A1
    A1 A1 A1
       A1

  rotate_map
      2
    3 0 1
      0

  lower_plate ss 5.0 0.5   ! mat, thickness, vol frac
  upper_plate ss 7.6 0.5   ! mat, thickness, vol frac
  lower_ref   mod 26.0 1.0
  upper_ref   mod 25.0 1.0

  bc_rad reflecting

  mat he     0.000176
  mat inc    8.19
  mat ss     8.0
  mat zirc   6.56
!  mat aic   10.20
  mat aic       10.17     ag-107 4.11010E-01 ! WEC data run through SCALE
                         ag-109 3.88990E-01
                         in-113 6.32772E-03
                         in-115 1.43672E-01
                         cd-00  5.00000E-02 ! combined cd for MPACT
                        /thexp=6.9
  mat pyrex  2.23
  mat b4c    6.56

  vessel mod 166.7 ss 169.2 mod 169.9 ss 174.1 mod 176.1 cs 201.9   ! complicated vessel card

[ASSEMBLY]
  title "Westinghouse 17x17"
  npin 3    ! *** scaled to 3x3
  ppitch 1.260

  fuel U31 10.251 95.10 / 3.1
  fuel U32 10.252 95.20 / 3.2
  fuel U33 10.253 95.30 / 3.3
  fuel U34 10.254 95.40 / 3.4
  fuel U35 10.255 95.50 / 3.5
  fuel U36 10.256 95.60 / 3.6
  fuel U37 10.257 95.70 / 3.7
  fuel U38 10.258 95.80 / 3.8
  fuel U39 10.259 95.90 / 3.9

!=== material label, key_name, density (lib_name defaults to key_name)
  mat he   0.000176
  mat inc  8.19
  mat ss   8.0
  mat zirc 6.56

  cell 1     0.4091 0.418 0.475 / U31 he zirc
  cell 2     0.4092 0.418 0.475 / U31 he zirc
  cell 3     0.4093 0.418 0.475 / U31 he zirc
  cell 4     0.4094 0.418 0.475 / U31 he zirc
  cell 5     0.4095 0.418 0.475 / U31 he zirc
  cell 6     0.4096 0.418 0.475 / U31 he zirc
  cell 7     0.4097 0.418 0.475 / U31 he zirc
  cell 8     0.4098 0.418 0.475 / U31 he zirc
  cell 9     0.4099 0.418 0.475 / U31 he zirc
  cell GT           0.561 0.602 / mod    zirc       ! guide tube
  cell IT           0.561 0.602 / mod    zirc       ! instrument tube
  cell MT           0.418 0.475 / mod    mod        ! empty location
  cell PL           0.418 0.475 /     he zirc       ! plenum
  cell PC                 0.475 /        zirc       ! pincap

  lattice FUEL1
      IT
       1 1

  lattice FUEL2
      IT
       2 2

  lattice FUEL3
      IT
       3 3

  lattice FUEL4
      IT
       4 4

  lattice FUEL5
      IT
       5 5

  lattice FUEL6
      IT
       6 6

  lattice FUEL7
      IT
       7 7

  lattice FUEL8
      IT
       8 8

  lattice FUEL9
      IT
       9 9

  lattice LGAP1
      IT
      MT MT

  lattice PLEN1
      IT
      PL PL

  lattice PCAP1
      IT
      PC PC

  axial A1    6.050
      LGAP1  10.281
      PCAP1  11.951
      FUEL1  15.817
      FUEL2  48.662
      FUEL3  77.105
      FUEL4  93.235
      FUEL5 109.365
      FUEL6 125.495
      FUEL7 137.37
      FUEL8 213.765
      FUEL9 377.711
      PLEN1 393.711
      PCAP1 395.381
      LGAP1 397.501

  grid END inc  3.866  31.67  0.9070 ! height (cm), mass (g), loss coef  *** scaled to 3x3
  grid MID zirc 3.810  27.25  0.9065 ! height (cm), mass (g), loss coef  *** scaled to 3x3

  grid_axial
      END  13.884
      MID  75.2
      MID 127.4
      MID 179.6
      MID 231.8
      MID 284.0
      MID 336.2
      END 388.2

  lower_nozzle  ss 6.05  194.64  ! mat, height, mass (g)  *** mass scaled to 3x3
  upper_nozzle  ss 8.827 194.64  ! mat, height, mass (g)  *** mass scaled to 3x3

[EDITS]

!  approximately 3in intervals in active fuel
  axial_edit_bounds
          11.951
          15.817
          24.028
          32.239
          40.45
          48.662
          56.873
          65.084
          73.295
          77.105
          85.17
          93.235
          101.3
          109.365
          117.43
          125.495
          129.305
          137.37
          145.435
          153.5
          161.565
          169.63
          177.695
          181.505
          189.57
          197.635
          205.7
          213.765
          221.83
          229.895
          233.705
          241.77
          249.835
          257.9
          265.965
          274.03
          282.095
          285.905
          293.97
          302.035
