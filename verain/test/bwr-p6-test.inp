      346.0262
      353.9474
      361.8686
      369.7898
      377.711

[MPACT]
  num_space     29
  num_angle      1
  num_threads    1
  num_inners     2

[COBRATF]
  beta_sp   0.005
  parallel       0
  property_evaluations asme1968

