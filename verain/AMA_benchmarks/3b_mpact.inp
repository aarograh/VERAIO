     - - -
     4 - - -
     - - - - -
     - - - - - 4
     - - - 4 - - -
     - - - - - - - -
     - - - - - - - - -


  rodmap PLUG 
     -
     - -
     - - -
     5 - - -
     - - - - -
     - - - - - 5
     - - - 5 - - -
     - - - - - - - -
     - - - - - - - - -

  axial PY16    15.761 
         LAT16 376.441 
         PLEN  401.181 

