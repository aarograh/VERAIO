#!/bin/bash

#PBS -A nfi011
#PBS -l nodes=1 
#PBS -l walltime=00:01:00
#PBS -o p2.stdout
#PBS -N MPACT_2f
#PBS -l gres=atlas1%atlas2
#PBS -j oe
#PBS -m ea
#PBS -M agm@ornl.gov
#PBS -q batch

cd $PBS_O_WORKDIR
export LD_LIBRARY_PATH=${HDF5_DIR}/lib:$LD_LIBRARY_PATH
export OMP_NUM_THREADS=1

case=p2
cores=8 

# set executables
mpact=$PROJWORK/nfi011/agm/mpact/MPACT_11052014

# set executables
parser=$mpact/test9/VERAInExt/verain/scripts/react2xml.pl 
exe=$mpact/build/MPACT_Drivers/examples/MPACT/MPACT.exe

export MPACT_DATA=$mpact/MPACT/MPACT_Extras/xslibs/

pwd

date
echo case = $case
echo input = $case.inp
echo executable = $exe
echo data = $MPACT_DATA
echo


# parse input 
rm -f $case.xml
echo "============================================="
echo "   Parsing VERA input"
echo "============================================="
perl $parser --init $case.inp $case.xml
ls -l $case.xml
date

# run MPACT 
echo "============================================="
echo "   Running MPACT Job on $cores cores"
echo "============================================="
aprun -n $cores $exe $case.xml
date
