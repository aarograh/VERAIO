#!/bin/bash
#PBS -A nfi011
#PBS -l nodes=33 
#PBS -l walltime=00:15:00
#PBS -o 4a-60.stdout
#PBS -N MPACT_4a-60 
#PBS -l gres=atlas1%atlas2
#PBS -j oe
#PBS -m ea
#PBS -M agm@ornl.gov
#PBS -q batch

cd $PBS_O_WORKDIR
export LD_LIBRARY_PATH=${HDF5_DIR}/lib:$LD_LIBRARY_PATH
export OMP_NUM_THREADS=1

case=4a-60
cores=522

# set executables
mpact=MPACT_BUILD

# set executables
parser=$mpact/MPACT/VERAInExt/verain/scripts/react2xml.pl 
exe=$mpact/build/MPACT_Drivers/examples/MPACT/MPACT.exe

export MPACT_DATA=$mpact/MPACT/MPACT_Extras/xslibs/
pwd

date
echo case = $case
echo input = $case.inp
echo executable = $exe
echo data = $MPACT_DATA
echo

# parse input 
rm -f $case.xml
echo "============================================="
echo "   Parsing VERA input"
echo "============================================="
perl $parser --init $case.inp $case.xml
ls -l $case.xml
date

# run MPACT 
echo "============================================="
echo "   Running MPACT Job on $cores cores"
echo "============================================="
aprun -n $cores $exe $case.xml
date
