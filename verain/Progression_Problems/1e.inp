[CASEID]
  title 'CASL AMA Benchmark Problem 1E - IFBA PIN - Public'

[STATE]
  power    0.0
  tinlet   600 K 
  tfuel    600 K
  modden   0.743         ! g/cc
  boron    1300	         ! ppm
  feedback off

[CORE]
  size   1
  apitch 1.26
  height 1.0
  rated  0.01 0.01

  core_shape
    1

  assm_map
   IFBA

  bc_rad reflecting
  bc_top reflecting
  bc_bot reflecting

[ASSEMBLY]
