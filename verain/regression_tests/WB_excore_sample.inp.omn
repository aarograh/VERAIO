[TALLY]

! Cell flux tally
[TALLY][CELL flux_tally]
reactions flux 
cells detector_ne_top  detector_ne_bot
nbins 20e6 1e6 1e5 1e3 10 1 1e-5

! U-235 response tally
[TALLY][CELL src_detectors_u235]
cells detector_sr1 detector_sr2
responses U235resp

[TALLY][CELL pr_detectors_u235]
cells detector_ne_top detector_ne_bot detector_nw_top detector_nw_bot
      detector_se_top detector_se_bot detector_sw_top detector_sw_bot
responses U235resp

! B-10 response tally
