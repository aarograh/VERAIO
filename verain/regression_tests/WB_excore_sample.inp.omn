responses B10_mt101

[TALLY][CELL pr_detectors_b10]
cells detector_ne_top detector_ne_bot detector_nw_top detector_nw_bot
      detector_se_top detector_se_bot detector_sw_top detector_sw_bot
responses B10_mt101

