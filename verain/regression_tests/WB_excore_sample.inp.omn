! ===========================================================
! **************  DETAILED EX-CORE DETECTOR  ****************
! ===========================================================

! *********************  DEFINE SHAPES  **********************

[GEOMETRY]
global "excore"

! Reactor core from Vera Input inserted into this universe
[UNIVERSE=core reactor]

! ============================================================
!   UNIVERSE: POWER RANGE DETECTOR - NE QUADRANT
! ============================================================

[UNIVERSE=general pr_detector_ne]
boundary detector_ne

! *******  SHAPE DEFINITIONS FOR POWER-RANGE DETECOR IN NE QUAD  *******

! Detector Well - NE QUAD
[UNIVERSE][SHAPE=cuboid det_well_ne]
faces -37.5 37.5 -11.5 11.5 -15.08 413.937

[UNIVERSE][SHAPE=hopper det_well_hopper_ne]
euler    0.25  0.75  0
extents  0  12.8
lo       11.5  225.9685
hi       20.0  224.4685
origin   -24.7 0 199.4685

! Detector loading tube - NE Quad - top
[UNIVERSE][SHAPE=cyl det_tube_od_ne_top]
radius 9.5
extents 194.831 347.231
origin -27 0 0
axis z

[UNIVERSE][SHAPE=cyl det_tube_id_ne_top]
radius 8.75
extents 194.831 347.231
origin -27 0 0
axis z

! Detector loading tube - NE Quad - bottom
[UNIVERSE][SHAPE=cyl det_tube_od_ne_bot]
radius 9.5
extents 42.431 194.831
origin -27 0 0
axis z

[UNIVERSE][SHAPE=cyl det_tube_id_ne_bot]
radius 8.75
extents 42.431 194.831
origin -27 0 0
axis z

[UNIVERSE][SHAPE=cuboid detector_ne]
faces -37.5 37.5 -20 20 -15.08 413.937

! ******************  POWER-RANGE DETECTOR IN THE NE QUADRANT  ********************

[UNIVERSE][CELL detector_well_ne]
comp air
shapes -det_well_ne +det_tube_od_ne_top +det_tube_od_ne_bot

[UNIVERSE][CELL detector_well_hopper_ne]
comp air
shapes -det_well_hopper_ne +det_well_ne -detector_ne

[UNIVERSE][CELL detector_tube_ne_top]
comp cs
shapes +det_tube_id_ne_top -det_tube_od_ne_top

[UNIVERSE][CELL detector_ne_top]
comp void
shapes -det_tube_id_ne_top

[UNIVERSE][CELL detector_tube_ne_bot]
comp cs
shapes +det_tube_id_ne_bot -det_tube_od_ne_bot

[UNIVERSE][CELL detector_ne_bot]
comp void
shapes -det_tube_id_ne_bot

[UNIVERSE][CELL outside_detector_ne]
comp concrete
shapes -detector_ne +det_well_ne +det_well_hopper_ne

[UNIVERSE][CELL hole_boundary_ne]
comp concrete
shapes -detector_ne

