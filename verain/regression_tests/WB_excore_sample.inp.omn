! **********************  CREATE HOLES AND FILL WITH UNIVERSES  **********************

! The Inner Barrel Radius is 187.96 cm
! The bottom left corner of the core is at 0,0,0
! It must be translated except when performing a raytrace
[UNIVERSE][HOLE thecore]
fill reactor
translate -193.68 -193.68  0.0

[UNIVERSE][HOLE power_range_det_ne]
fill pr_detector_ne
rotate 0.7071067811865476 -0.7071067811865476 0
       0.707106781186547   0.707106781186547  0
       0                   0                  1
translate 208.030815 208.030815 0.0

[UNIVERSE][HOLE power_range_det_nw]
fill pr_detector_nw
rotate -0.7071067811865476 -0.7071067811865476 0
        0.707106781186547  -0.707106781186547  0
        0                   0                  1
translate -208.030815 208.030815 0.0

[UNIVERSE][HOLE power_range_det_sw]
fill pr_detector_sw
rotate -0.7071067811865476  0.7071067811865476 0
       -0.707106781186547  -0.707106781186547  0
        0                   0                  1
translate -208.030815 -208.030815 0.0

[UNIVERSE][HOLE power_range_det_se]
fill pr_detector_se
rotate  0.7071067811865476  0.7071067811865476 0
       -0.707106781186547   0.707106781186547  0
        0                   0                  1
translate 208.030815 -208.030815 0.0

[UNIVERSE][HOLE source_range_det1]
fill sr_detector_1
rotate   0  -1   0
         1   0   0
         0   0   1
translate 0.0 294.2 0.0

[UNIVERSE][HOLE source_range_det2]
fill sr_detector_2
rotate   0   1   0
        -1   0   0
         0   0   1
translate 0.0 -294.2 0.0

! **********************************  DEFINE CELLS  **********************************

! [UNIVERSE][CELL barrel]
! comp ss
! shapes +thecore -outer_barrel

[UNIVERSE][CELL moderator]
comp mod
shapes +thecore  -inner_liner     +pad_ne          +pad_nw          +pad_sw 
       +pad_se        +sliver_water_ne +dsc_piece1_ne   +dsc_piece2_ne   +dsc_piece3_ne 
       +dsc_piece4_ne +dsc_piece5_ne   +sliver_water_sw +dsc_piece1_sw   +dsc_piece2_sw 
       +dsc_piece3_sw +dsc_piece4_sw   +dsc_piece5_sw   +sliver_water_nw +ssc_piece1_nw
       +ssc_piece2_nw +sliver_water_se +ssc_piece1_se   +ssc_piece2_se 

[UNIVERSE][CELL pad_ne_quad]
comp ss
shapes -pad_ne 

[UNIVERSE][CELL pad_nw_quad]
comp ss
shapes -pad_nw

[UNIVERSE][CELL pad_sw_quad]
comp ss
shapes -pad_sw

[UNIVERSE][CELL pad_se_quad]
comp ss
shapes -pad_se

[UNIVERSE][CELL rpv_liner]
comp ss
shapes +inner_liner -inner_vessel

[UNIVERSE][CELL rpv]
comp cs
shapes +inner_vessel -outer_vessel

[UNIVERSE][CELL airgap1]
comp air
shapes +outer_vessel -agap_od

[UNIVERSE][CELL rpv_insulation]
comp rpv_mat
shapes +agap_od -insulation_od

[UNIVERSE][CELL airgap2]
comp air
shapes +insulation_od -liner_id +power_range_det_ne +power_range_det_nw +power_range_det_sw
       +power_range_det_se +source_range_det1 +source_range_det2

[UNIVERSE][CELL shield_liner]
comp ss
shapes +liner_id -liner_od +power_range_det_ne +power_range_det_nw +power_range_det_sw 
       +power_range_det_se +source_range_det1 +source_range_det2

[UNIVERSE][CELL bioshield]
comp concrete
shapes +liner_od -shield_od +power_range_det_ne +power_range_det_nw +power_range_det_sw
       +power_range_det_se +source_range_det1 +source_range_det2

[UNIVERSE][CELL airgap3]
comp air
shapes +shield_od -box

! ************ DUAL SURVEILLANCE CAPSULE IN THE NE QUADRANT **************

[UNIVERSE][CELL capsule_water_ne]
comp mod
shapes -sliver_water_ne 

[UNIVERSE][CELL cs_double_capsule_ne]
comp cs
shapes -dsc_piece1_ne +sliver_water_ne +dsc_holder1_ne +dsc_holder2_ne

[UNIVERSE][CELL cs_double_capsule2_ne]
comp cs
shapes -dsc_piece2_ne +dsc_holder1_ne +dsc_holder2_ne

[UNIVERSE][CELL cs_double_capsule3_ne]
comp cs
shapes -dsc_piece3_ne +dsc_holder1_ne +dsc_holder2_ne

[UNIVERSE][CELL cs_double_capsule4_ne]
comp cs
shapes -dsc_piece4_ne +dsc_holder1_ne +dsc_holder2_ne

[UNIVERSE][CELL cs_double_capsule5_ne]
comp cs
shapes -dsc_piece5_ne +dsc_holder1_ne +dsc_holder2_ne

[UNIVERSE][CELL double_capsule_holder1_ne]
comp cs
shapes -dsc_holder1_ne

[UNIVERSE][CELL double_capsule_holder2_ne]
comp cs
shapes -dsc_holder2_ne

! ************ DUAL SURVEILLANCE CAPSULE IN THE SW QUADRANT **************

[UNIVERSE][CELL capsule_water_sw]
comp mod
shapes -sliver_water_sw 

[UNIVERSE][CELL cs_double_capsule_sw]
comp cs
shapes -dsc_piece1_sw +sliver_water_sw +dsc_holder1_sw +dsc_holder2_sw

[UNIVERSE][CELL cs_double_capsule2_sw]
comp cs
shapes -dsc_piece2_sw +dsc_holder1_sw +dsc_holder2_sw

[UNIVERSE][CELL cs_double_capsule3_sw]
comp cs
shapes -dsc_piece3_sw +dsc_holder1_sw +dsc_holder2_sw

[UNIVERSE][CELL cs_double_capsule4_sw]
comp cs
shapes -dsc_piece4_sw +dsc_holder1_sw +dsc_holder2_sw

[UNIVERSE][CELL cs_double_capsule5_sw]
comp cs
shapes -dsc_piece5_sw +dsc_holder1_sw +dsc_holder2_sw

[UNIVERSE][CELL double_capsule_holder1_sw]
comp cs
shapes -dsc_holder1_sw

[UNIVERSE][CELL double_capsule_holder2_sw]
comp cs
shapes -dsc_holder2_sw

! ************ SINGLE SURVEILLANCE CAPSULE IN THE SW QUADRANT **************

[UNIVERSE][CELL capsule_water_nw]
comp mod
shapes -sliver_water_nw 

[UNIVERSE][CELL cs_single_capsule_nw]
comp cs
shapes -ssc_piece1_nw +sliver_water_nw +ssc_holder_nw

[UNIVERSE][CELL cs_single_capsule2_nw]
comp cs
shapes -ssc_piece2_nw +ssc_holder_nw

[UNIVERSE][CELL cs_single_holder_nw]
comp cs
shapes -ssc_holder_nw

! ************ SINGLE SURVEILLANCE CAPSULE IN THE SE QUADRANT **************

[UNIVERSE][CELL capsule_water_se]
comp mod
shapes -sliver_water_se 

[UNIVERSE][CELL cs_single_capsule_se]
comp cs
shapes -ssc_piece1_se +sliver_water_se +ssc_holder_se

[UNIVERSE][CELL cs_single_capsule2_se]
comp cs
shapes -ssc_piece2_se +ssc_holder_se

[UNIVERSE][CELL cs_single_holder_se]
comp cs
shapes -ssc_holder_se +co +fe +cu

[UNIVERSE][CELL co_coupon]
comp co
shapes -co

[UNIVERSE][CELL fe_coupon]
comp fe
shapes -fe

[UNIVERSE][CELL cu_coupon]
comp cu
shapes -cu

