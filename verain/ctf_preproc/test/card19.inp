! Author: Bob Salko
! Date: 3/10/2016
! Description:
!   Tests that the PWR preprocessor correctly reads the stopping criteria from 
!   the XML file and delivers them to the CTF input deck.

[STATE]
  power  100.0         ! %
  tinlet 559.0 F         ! F
  boron  1300          ! ppmB
  pressure 2250        ! psia

  tfuel 900.0 K         ! K - 600K  Not used with T/H feedback! set to 900K with feedback
  modden 0.743         ! g/cc      Not used with T/H feedback!

  feedback on
  sym full

[CORE]
  size 1                ! 1x1 single-assembly
  rated 17.67   0.6824  ! MW, Mlbs/hr
  apitch 21.5
  height 406.328

  core_shape
    1

  assm_map
    A1

  lower_plate ss 5.0 0.5   ! mat, thickness, vol frac
  upper_plate ss 7.6 0.5   ! mat, thickness, vol frac
  lower_ref   mod 26.0 1.0
  upper_ref   mod 25.0 1.0


  bc_rad reflecting

  mat he     0.000176
  mat inc    8.19
  mat ss     8.0
  mat zirc   6.56 zirc4
  mat aic   10.20
  mat pyrex  2.23
  mat b4c    6.56

[ASSEMBLY]
