[CASEID]
  title '5x5 rod problem HFP - Case 5'
!================================================================================
!  5x5 Test case 5 - Increase Pressure
!
!================================================================================

[STATE]
  power    100.0       ! %
  tinlet 559.0 F       ! F
  boron    1300        ! ppmB
  pressure 2570        ! psia   ** increased from base

! tfuel  600.0         ! K - 600K  Not used with T/H feedback!
! modden 0.743         ! g/cc      Not used with T/H feedback!

  feedback on

[CORE]
  size 1                   ! 1x1 single-assembly

!
! power reduced for small problem (use number of heated pins)
!    power = 17.6736*(24)/(269)=1.577 MW
!
! flow reduced for small problem
!    flow = 0.6824*(5*5)/(17*17)=0.059 Mlbs/hr
!
  rated 1.577  0.059       ! MW, Mlbs/hr
  apitch 6.38              ! 5 pins x 1.26 cm + 2*0.04 gap
  height 406.328

  core_shape
    1

  assm_map
    A1

  lower_plate ss 5.0 0.5   ! mat, thickness, vol frac
  upper_plate ss 7.6 0.5   ! mat, thickness, vol frac

  bc_rad reflecting

  mat he     0.000176
  mat inc    8.19
  mat ss     8.0
  mat zirc   6.56
  mat aic   10.20
  mat pyrex  2.23
  mat b4c    6.56

[ASSEMBLY]
  title "5x5 Rod Assembly"
  npin 5
  ppitch 1.26

  fuel U31 10.257 95.0 / 3.1

!=== material label, key_name, density
  mat he    0.000176
  mat inc   8.19
  mat ss    8.0
  mat zirc  6.56

  cell 1     0.4096 0.418 0.475   / U31 he zirc       ! fuel rod
  cell 2            0.561 0.602   / mod    zirc       ! instrument tube
  cell 8            0.418 0.475   /     he zirc       ! plenum
  cell 9                  0.475   /        zirc       ! pincap

  lattice FUEL1
      2
      1 1
      1 1 1

  lattice PLEN1
      2
      8 8
      8 8 8

  lattice PCAP1
      2
      9 9
      9 9 9

!  Note: active fuel = 365.76cm = 12ft = 377.711 - 11.951

  axial A1    6.050
      PCAP1  11.951
      FUEL1 377.711
      PLEN1 393.711
      PCAP1 397.501

! grid masses reduced for small problem
!    END = 1017*(5*5)/(17*17)=87.98
!    MID =  875*(5*5)/(17*17)=75.69

  grid END inc   3.866  87.98  0.9070   ! grid height (cm), mass (g), loss coef
  grid MID zirc  3.810  75.69  0.9065   ! grid height (cm), mass (g), loss coef

  grid_axial     ! centerline elevations
      END  13.884
      MID  75.2
      MID 127.4
      MID 179.6
      MID 231.8
      MID 284.0
      MID 336.2
      END 388.2

! nozzle masses reduced by (3.80/21.50)^2
!    nozzle =  6250*(5*5)/(17*17)=540.66

  lower_nozzle  ss 6.05  540.66  ! mat, height, mass (g)
  upper_nozzle  ss 8.827 540.66  ! mat, height, mass (g)

[EDITS]

!  3in intervals in active fuel + grid
  axial_edit_bounds
          11.951
          15.817
          24.028
          32.239
          40.45
          48.662
          56.873
          65.084
          73.295
          77.105
          85.17
          93.235
          101.3
          109.365
          117.43
          125.495
          129.305
          137.37
          145.435
          153.5
          161.565
          169.63
          177.695
          181.505
          189.57
          197.635
          205.7
          213.765
          221.83
          229.895
          233.705
          241.77
          249.835
          257.9
          265.965
          274.03
          282.095
          285.905
          293.97
          302.035
          310.1
          318.165
          326.23
          334.295
          338.105
          346.0262
          353.9474
          361.8686
          369.7898
          377.711

[COBRATF]
  nfuel   3
  irfc    2
  epso    0.001
  oitmax  5
  iitmax  40


  dtmin   0.000001
  dtmax   0.1
  tend    0.1
  rtwfp   1000.0
  maxits  10000
  maps_filename = case5-05

