[MPACT]
   vis_edits         none
   rod_treatment     polynomial
   grid_treatment    equal_mass

!T/H
   coupling_method   ctf
   sth_hgap          4500
   sth_dhfrac        0.02

!moc
   moc_kernel        mg
   ray_spacing       0.05
   azimuthals_octant 16
   polars_octant     2
   quad_type         CHEBYSHEV-YAMAMOTO

!iteration_control
   k_tolerance       1e-5
   flux_tolerance    1e-4
   num_inners        3
   num_outers        500
   up_scatter        2
   scattering        TCP0

!cmfd
   cmfd              adcmfd
   cmfd_solver       mgnode  !1gsweep
   !cmfd_eigen_solver jd      !power
   k_shift           1.5
   cmfd_num_outers   20
   prolongation      flat

!2D1D
   split_TL          true
   TL_treatment      lflat
   nodal_method      sp3
 ! under_relax       1.0

!parallel
   num_space         1
   num_angle         1
   num_energy        1
   num_threads       1
 ! par_method        EXPLICITFILE
 ! par_file          partition.txt

!xs_library
 ! xs_filename       mpact47g_70s_v3.1_11032014.fmt
   xs_filename       mpact47g_70s_v4.0_11032014.fmt
   xs_type           ORNL
   subgroup_set      4
   dep_kernel        origen
   dep_filename      origen_data_paths_casl2.0.txt
   dep_substep       3
   dep_edit          false

  polars_octant     2
  azimuthals_octant 16
!parallel
  num_space         1
  num_angle         1
  num_energy        1
  num_threads       1
  par_method        PS
!xs_library
  xs_filename       mpact8g_70s_v4.0m0_02232015.fmt
