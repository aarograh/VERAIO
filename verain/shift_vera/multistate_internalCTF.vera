[CASEID]
  title 'Single pin calculation for testing mpact with an embedded COBRA-TF'

[STATE]
  tinlet 559.0 F       ! F
  boron  600           ! ppmB
  pressure 2250        ! psia

  tfuel 900.0 K        ! K - 600K  Not used with T/H feedback! set to 900K with feedback
  modden 0.743         ! g/cc      Not used with T/H feedback!

  feedback on
  sym full

                            power  0.000001
[STATE] deplete EFPD 100.0; power 100.0
[STATE]                     power  0.000001

[CORE]
  size 1                ! 1x1 assemblies
  rated 0.0670   0.0024  ! MW, Mlbs/hr
  apitch 1.26 
  height 406.328

  core_shape
    1
  assm_map
    A1

  lower_plate zirc4 5.0 0.5   ! mat, thickness, vol frac
  upper_plate zirc4 7.6 0.5   ! mat, thickness, vol frac
  lower_ref   mod 26.0 1.0
  upper_ref   mod 25.0 1.0


  bc_rad reflecting

   mat he     0.17860E-03  o-16   1.0          ! MPACT Default
   mat zirc4       6.56    cr-50   4.173685E-05 !MPACT Default
                           cr-52   8.369935E-04
                           cr-53   9.673587E-05
                           cr-54   2.453364E-05
                           fe-54   1.185567E-04
                           fe-56   1.929932E-03
                           fe-57   4.536773E-05
                           fe-58   6.143432E-06
                           hf-174  1.559258E-07
                           hf-176  5.185040E-06
                           hf-177  1.843933E-05
                           hf-178  2.719727E-05
                           hf-179  1.365516E-05
                           hf-180  3.536726E-05
                           sn-112  1.325870E-04
                           sn-114  9.182450E-05
                           sn-115  4.771906E-05
                           sn-116  2.058423E-03
                           sn-117  1.096647E-03
                           sn-118  3.487981E-03
                           sn-119  1.247577E-03
                           sn-120  4.771540E-03
                           sn-122  6.894095E-04
                           sn-124  8.762916E-04
                           zr-90   4.980862E-01
                           zr-91   1.098299E-01
                           zr-92   1.697228E-01
                           zr-94   1.757443E-01
                           zr-96   2.891684E-02

!  mat ss     8.0

[ASSEMBLY]
  title "Westinghouse 1x1"
  npin 1 
  ppitch 1.260

  fuel U31 10.257 95.0 / 3.1

!=== material label, key_name, density (lib_name defaults to key_name)
!  mat he   0.000176
!  mat inc  8.19
!  mat ss   8.0
!  mat zirc 6.56 zirc4

  cell 1     0.4096 0.418 0.475 / U31 he zirc4
  cell 7            0.418 0.475 / mod    mod         ! empty location
  cell 8            0.418 0.475 /     he zirc4       ! plenum
  cell 9                  0.475 /        zirc4       ! pincap

  lattice FUEL1
     1

  lattice LGAP1
     7

  lattice PLEN1
     8
  
  lattice PCAP1
     9

  axial A1    6.050
      LGAP1  11.951
      FUEL1 377.711
      PLEN1 393.711
      LGAP1 397.501

  grid END zirc4 3.866  4.67  0.9070
  grid MID zirc4 3.810  3.25  0.9065

  grid_axial
      END  13.884
      MID  75.2
      MID 127.4
      MID 179.6
      MID 231.8
      MID 284.0
      MID 336.2
      END 388.2

  lower_nozzle  zirc4 6.05   25.0  ! mat, height, mass (g)
  upper_nozzle  zirc4 8.827  25.0  ! mat, height, mass (g)

