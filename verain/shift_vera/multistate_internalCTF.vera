[COBRATF]
  nc      1             ! conduction option - radial conduction
  irfc    2             ! friction factor correlation default=2
  dhfrac  0.02          ! fraction of power deposited directly into coolant
  hgap    5678.3        ! gap conductance
  epso    0.001
  oitmax  5
  iitmax  40
  dtmin   0.000001
  dtmax   0.1
  tend    0.1
  rtwfp   1000.0
  maxits  10000
  courant 0.8
  parallel 0
  pressure_criteria     1e-4
  void_criteria         1e-4
  Tcool_criteria        1e-4
  Tsolid_criteria       1e-4
  vliq_criteria         1e-4
  vvap_criteria         1e-4
  global_mass_balance   1e-4 ! %
  global_energy_balance 1e-4 ! %

  
[COUPLING]
  epsk        5.0  ! pcm
  epsp        1.0e-4
  rlx_power   0.65
  rlx_tfuel   1.0
  rlx_den     1.0
  maxiter     10

[INSILICO]
  transport           ce_mc
  !seed                45352213
  !global_log          diagnostic
  num_cycles          10
  num_inactive_cycles 5
  !k_init              1.0
  Np                  1000
