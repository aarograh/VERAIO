"_directory.yml":{
  "TRANSIENT" : {
    "timestep" : {
      "_content" : null,
      "_style" : "multi-line",
      "_parse" : "list",
      "_check" : [
          "arraysize()%2==0",
          "fall(sub{is_float(shift)},())",
          "fall(sub{is_gt(shift,0.0)},())",
          "is_strictlyincreasing(odd([]))"
      ],
      "_named" : "0"
    },
    "scram_type" : {
      "_named" : "0",
      "_parse" : "list",
      "_style" : "multi-line",
      "_check" : [
          "is_word(nth(0,()))",
          "fall(sub{is_float(shift)},stride(1,2,()))",
          "fall(sub{is_geq(shift,0)},stride(1,2,()))",
          "fall(sub{is_float(shift)},stride(2,2,()))",
          "fall(sub{is_gt(shift,0)},stride(2,2,()))",
          "arraysize()%2!=0"
      ],
      "_content" : null
    },
    "trip_time" : {
      "_content" : null,
