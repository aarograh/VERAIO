"_blocks":{
  "CASEID" : {
    "_do" : [
       "setdb MAIN_DB"
    ],
    "_content" : {
      "case_id" : {
        "_pltype" : "parameter",
        "_type" : "string",
        "_content" : null,
        "_do" : [
             "copy CASEID/$title"
        ]
      }
    },
    "_pltype" : "list"
  }
,  "BRANCHES" : {
    "_tr" : {
      "_content" : "%BRANCH",
      "_name" : "_loop"
    },
    "_pltype" : "list",
    "_content" : {
      "Branch_(_loop)" : {
        "_content" : {
          "state_control" : {
            "_pltype" : "list",
            "_content" : {
              "variables" : {
                "_type" : "string",
                "_pltype" : "array",
                "_do" : [
                         "copyarray %BRANCH/(_path)/@state_control,select=>even"
                ],
                "_content" : null
              },
              "values" : {
                "_do" : [
                         "copyarray %BRANCH/(_path)/@state_control,select=>odd"
                ],
                "_content" : null,
                "_pltype" : "array",
                "_type" : "string"
              }
            }
          },
          "id" : {
            "_type" : "string",
            "_pltype" : "parameter",
            "_do" : [
                   "copy %BRANCH/$(_loop)/$id"
            ],
            "_content" : null
          },
          "title" : {
            "_pltype" : "parameter",
            "_type" : "string",
            "_content" : null,
            "_do" : [
                   "copy %BRANCH/$(_loop)/$title"
            ]
          },
          "BranchSets" : {
            "_content" : {
              "BranchSet_(_bloop)" : {
                "_pltype" : "array",
                "_type" : "string",
                "_content" : null,
                "_do" : [
                         "copyarray %BRANCH/(_path)/%branch_set/@(_bloop)"
                ]
              }
            },
            "_tr" : {
              "_content" : "%BRANCH/(_path)/%branch_set",
              "_name" : "_bloop"
            },
            "_pltype" : "list"
          }
        },
        "_do" : [
             "setvar _path,%BRANCH/$(_loop)",
             "getvar _path,apply=>&pathlevel,arg=>2"
        ],
        "_pltype" : "list"
      }
    },
    "_do" : [
       "setdb MAIN_DB"
    ]
  }
,  "STATES" : {
    "_content" : {
      "State_(_loop)" : {
        "_pltype" : "list",
        "_content" : {
          "restart_read_label" : {
            "_do" : [
                   "copy %STATE/$(_loop)/@restart_read:1"
            ],
            "_content" : null,
            "_type" : "string",
            "_pltype" : "parameter"
          },
          "crud_removal" : {
            "_pltype" : "parameter",
            "_type" : "double",
            "_do" : [
                   "copy %STATE/$(_loop)/$crud_removal"
            ],
            "_content" : null
          },
          "apitch_tec" : {
            "_pltype" : "parameter",
            "_type" : "double",
            "_content" : null,
            "_do" : [
                   "copy %STATE/$(_loop)/$apitch_tec"
            ]
          },
          "restart_write_file" : {
            "_type" : "string",
            "_pltype" : "parameter",
            "_do" : [
                   "copy %STATE/$(_loop)/@restart_write:0"
            ],
            "_content" : null
          },
          "jump_in_file" : {
            "_do" : [
                   "copy %STATE/$(_loop)/$jump_in_file"
            ],
            "_content" : null,
            "_pltype" : "parameter",
            "_type" : "string"
          },
          "b10" : {
            "_pltype" : "parameter",
            "_type" : "double",
            "_content" : null,
            "_do" : [
                   "copy %STATE/$(_loop)/$b10:0"
            ]
          },
          "fe_sol" : {
            "_do" : [
                   "copy %STATE/$(_loop)/$cool_chem:4"
            ],
            "_content" : null,
            "_type" : "double",
