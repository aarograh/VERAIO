          "fall(sub{is_float(shift)},stride(2,4,()))",
          "fall(sub{is_int(shift)},stride(3,4,()))",
          "fall(sub{0<=(shift)},stride(1,4,()))",
          "fall(sub{0.0<(shift)},stride(2,4,()))",
          "fall(sub{0<(shift)},stride(3,4,()))",
          "fall(sub{1000>(shift)},stride(1,4,()))",
          "fall(sub{1.0>=(shift)},stride(2,4,()))",
