[RUN]      walltime 2.0
[CASEID]   title 'B&W Cycle N-4 Jump-In'      
[STATE]  
  power    0.0   
  tinlet   532 F 
  rodbank  1 100  2 100  3 100  4 100  5 100  6 100  7 100  8 35  ! ARO
  pressure 2200

  sym      qtr
  feedback on   
  thexp    on
  search   boron

  restart_jumpin  H-8  1/shuf.res 39.6 A-1
                  H-10 3/shuf.res 21.5 A-1
                  H-12 3/shuf.res 16.8 A-1
                  H-14 3/shuf.res 16.8 A-1
                  H-15 2/shuf.res 31.6 A-1
                  K-9  2/shuf.res 36.5 A-1
                  K-11 2/shuf.res 33.7 A-1
                  K-13 3/shuf.res 21.5 A-1
                  K-15 2/shuf.res 41.0 A-1
                  L-8  3/shuf.res 21.5 A-1
                  L-10 3/shuf.res 21.5 A-1
                  L-12 3/shuf.res 20.5 A-1
                  L-14 3/shuf.res 20.5 A-1
                  L-15 2/shuf.res 41.8 A-1
                  M-9  2/shuf.res 33.7 A-1
                  M-11 3/shuf.res 21.5 A-1
                  M-13 3/shuf.res 14.8 A-1
                  M-14 2/shuf.res 41.8 A-1
                  N-8  3/shuf.res 16.8 A-1
                  N-10 3/shuf.res 20.5 A-1
                  N-12 3/shuf.res 21.5 A-1
                  N-14 2/shuf.res 41.0 A-1
                  O-9  3/shuf.res 21.5 A-1
                  O-11 3/shuf.res 14.8 A-1
                  O-13 4/shuf.res 16.6 A-1
                  P-8  3/shuf.res 16.8 A-1
                  P-10 3/shuf.res 20.5 A-1
                  P-11 2/shuf.res 41.8 A-1
                  P-12 2/shuf.res 41.8 A-1
                  R-8  2/shuf.res 31.6 A-1
                  R-9  2/shuf.res 41.0 A-1
                  R-10 2/shuf.res 41.8 A-1
 
[STATE] 
  restart_write shuf.res BOC

[CORE]     include ../../core.inp
           include ../../cycle_n-4.inp
[ASSEMBLY] include ../../b3b.inp 
[ASSEMBLY] include ../../b3a.inp 
