     - - -
     1 - - -
     - - - - -
     - - - - - 1
     1 - - 1 - - -
     - - - - - - - -
     - - - - - - - - -

  rodmap  PY24  
     -
     - -
     - - -
     1 - - 1
     - - - - -
     - - - - - 1
     1 - - 1 - - -
     - - - - - - - -
     - - - - - - - - -

  axial   8  0.0  PY8   1.0
  axial  12  0.0  PY12  1.0
  axial  16  0.0  PY16  1.0
  axial  20  0.0  PY20  1.0
  axial  24  0.0  PY24  1.0

[CONTROL]
  title "B4C with AIC tips"
  npin 17
  stroke  1.0 1 

  mat aic 10.2 
  mat b4c 1.76

  cell 1  0.382 0.386 0.484 / aic he ss
  cell 2  0.373 0.386 0.484 / b4c he ss

  rodmap AIC
     -
     - -
     - - -
     1 - - 1
     - - - - -
     - - - - - 1
     1 - - 1 - - -
     - - - - - - - -
     - - - - - - - - -

  rodmap B4C
     -
     - -
     - - -
     2 - - 2
     - - - - -
     - - - - - 2
     2 - - 2 - - -
     - - - - - - - -
     - - - - - - - - -

  axial  A  0.0  AIC 1.0
  axial  B  0.0  B4C 1.0

[INSILICO]
!   pin_partitioning true
    cell_homogenize true
    eq_set        spn_fv 
    SPN_order     3 
    Pn_order      1
    tolerance     1e-6
    dimension     3
    mesh          2 
    Pn_correction true

    mat_library casl_comp_r2.sh5
    xs_library  v7-252

    max_delta_z   1.0
    num_blocks_i  12 
    num_blocks_j  12 
    num_groups    23
    num_sets      1

