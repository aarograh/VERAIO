  num_inners        3
  k_tolerance       1e-6
  up_scatter        2
  num_outers        100
  scattering        LTCP0
!cmfd
  cmfd              cmfd
  cmfd_solver       mgnode
  k_shift           1.5
  cmfd_num_outers   20
!2D1D
  split_TL          true
  TL_treatment      lflat
  nodal_method      nem
!  under_relax       1.0
!parallel
  num_space         60
  num_angle         1
  num_energy        1
  num_threads       1
!xs_library
  xs_filename       declib56g_e7_09042013_p0mixed.fmt
  xs_type           ORNL
  subgroup_set      4
!mesh

