    1
    - -
 
  crd_bank
    D
    - -

  lower_plate ss  5.0 0.5   ! mat, thickness, vol frac
  upper_plate ss  7.6 0.5 
 !lower_ref  mod 20.0 1.0   ! not needed

  bc_rad reflecting

[ASSEMBLY]
  title "Mini 7x7"
  npin 7 
  ppitch 1.26
  
  fuel U21 10.257 94.5 / 2.1 
  fuel U26 10.257 94.5 / 2.6 

  cell 1     0.4096 0.418 0.475 / U21 he zirc4
  cell 2     0.4096 0.418 0.475 / U26 he zirc4
  cell 3            0.561 0.602 / mod    zirc4      ! guide/instrument tube
  cell 4            0.418 0.475 /     he zirc4      ! plenum
  cell 5                  0.475 /        zirc4      ! end plug
  cell 6                  0.475 /        mod        ! empty    

  lattice LAT21 
       3
       1 1
       1 1 3
       1 1 1 1

  lattice LAT26  
       3
       2 2
       2 2 3
       2 2 2 2

  lattice PLEN
       3
       4 4
       4 4 3
       4 4 4 4


  lattice PLUG 
       3
       5 5
       5 5 3
       5 5 5 5

  lattice GAP  
       3
       6 6
       6 6 3
       6 6 6 6

  axial A21 6.053 GAP 10.281 PLUG 11.951 LAT21 377.711 PLEN 393.711 PLUG 395.381 GAP 397.51
  axial A26 6.053 GAP 10.281 PLUG 11.951 LAT26 377.711 PLEN 393.711 PLUG 395.381 GAP 397.51

  grid END inc   172.43 3.866
  grid MID zirc4 148.36 3.810

  grid_axial
      END  13.884
      MID  75.2
      MID 127.4
      MID 179.6
      MID 231.8
      MID 284.0
      MID 336.2
      END 388.2

  lower_nozzle  ss 6.053 1059.69  ! mat, height, mass (g)
  upper_nozzle  ss 8.827 1059.69  ! mat, height, mass (g)

[INSERT]
  title "Pyrex"
  npin 7

  cell 1  0.214 0.231 0.241 0.427 0.437 0.484 / he ss he pyrex-vera he ss
  cell 2                          0.437 0.484 /                     he ss  ! plenum
  cell 3                                0.484 /                        ss  ! plug  
  cell 4                                0.538 /                        ss  ! thimble plug

  rodmap  PY04
