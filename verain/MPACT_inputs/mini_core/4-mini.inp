[CASEID]
  title 'Mini Colorset - 3x3 array of 7x7 assemblies'

[STATE]
  power    0.0
  tinlet   600 K
  tfuel    600 K
  boron    1300           ! ppmB
  modden   0.743          ! g/cc
  rodbank  D 0            ! Bank D
  sym      qtr  
  feedback off
[STATE] rodbank D  46
[STATE] rodbank D  92
[STATE] rodbank D 138
[STATE] rodbank D 184
[STATE] rodbank D 230
  
[CORE]
