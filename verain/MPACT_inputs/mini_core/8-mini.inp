[CASEID]
  title 'Mini Core - using 7x7 assemblies'

[STATE]
  power     0.0
  tinlet   600 K
  tfuel    600 K
  boron    1300           ! ppmB
  modden   0.743          ! g/cc
  sym      qtr
  pressure 2250           ! psia
  feedback on
  rodbank  A 230
           B 178
           C 50
           D 0

[STATE] power 20.0 ; rodbank B 228 C 100      ; deplete hours 4.0; title 'Low Power Test Plateau'
[STATE] power 20.0 ; rodbank       C 126      ; deplete hours 8.0
[STATE] power 20.0 ; rodbank       C 150 D 22 ; deplete hours 12.0
[STATE] power 20.0 ; rodbank       C 174 D 46 ; deplete hours 16.0
[STATE] power 20.0 ; rodbank       C 210 D 82 ; deplete hours 22.0
[STATE] power 40.0 ; rodbank       C 230 D 106; deplete hours 26.0
[STATE] power 45.0 ; rodbank             D 112; deplete hours 27.0
[STATE] power 50.0 ; rodbank             D 118; deplete hours 28.0; title 'Intermediate Power Test Plateau'
[STATE] power 50.0 ; rodbank             D 120; deplete hours 29.0
[STATE] power 75.0 ; rodbank             D 160; deplete hours 34.0
[STATE] power 75.0 ; rodbank             D 171; deplete hours 40.0
[STATE] power 90.0 ; rodbank             D 177; deplete hours 43.0
[STATE] power 100.0; rodbank             D 215; deplete hours 48.0; title 'Full Power Test Plateau'

[CORE]
  include full_core.ini

![Assembly]/[Insert]/[Control]/[Edits]
include Asy_Ins_CR_Det_Edit.ini

[MPACT]
  include mpact_mini.ini

[COBRATF]
  beta_sp   0.005
  parallel  1

