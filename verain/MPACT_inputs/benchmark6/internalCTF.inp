[MPACT]
  vis_edits         none
  ray_spacing       0.1
!quad_set
  quad_type         CHEBYSHEV-GAUSS
  polars_octant     2
  azimuthals_octant 2
!iteration_control
  flux_tolerance    1e-5
  num_inners        3
  k_tolerance       1e-5
  up_scatter        2
  num_outers        100
  scattering        LTCP0
!cmfd
  cmfd              cmfd
  cmfd_solver       mgnode
  k_shift           1.5
  cmfd_num_outers   20
!2D1D
  split_TL          true
  TL_treatment      lflat
  nodal_method      nem
!  under_relax       1.0
!TH
  coupling_method   ctf
!parallel
  num_space         1
  num_angle         1
  num_energy        1
  num_threads       1
  par_method        PS
!xs_library
  xs_filename       mpact8g_70s_v4.0m0_02232015.fmt
  xs_type           ORNL
  subgroup_set      4
!mesh
  !meshing_method    useraxialmesh
  !automesh_bounds   2.0 20.0
  mesh fuel  1 1 1 / 4 4 4 4
  mesh gtube 1 1   / 4 4 4
  axial_mesh       26.0000
