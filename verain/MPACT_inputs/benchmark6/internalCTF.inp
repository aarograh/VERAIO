[CASEID]
  title 'Single pin calculation for testing mpact with an embedded COBRA-TF'

[STATE]
  power  100.0         ! %
  tinlet 559.0 F       ! F
  boron  600           ! ppmB
  pressure 2250        ! psia

  tfuel 900.0 K        ! K - 600K  Not used with T/H feedback! set to 900K with feedback
  modden 0.743         ! g/cc      Not used with T/H feedback!

  feedback on
  sym full

[CORE]
  size 1                ! 1x1 assemblies
  rated 0.0670   0.0024  ! MW, Mlbs/hr
  apitch 1.26
  height 406.328

  core_shape
    1
  assm_map
    A1

  lower_plate ss 5.0 0.5   ! mat, thickness, vol frac
  upper_plate ss 7.6 0.5   ! mat, thickness, vol frac
  lower_ref   mod 26.0 1.0
  upper_ref   mod 25.0 1.0


  bc_rad reflecting
  include mpact_test_mats.ini

!  mat ss     8.0

[ASSEMBLY]
  title "Westinghouse 1x1"
  npin 1
  ppitch 1.260

  fuel U31 10.257 95.0 / 3.1

!=== material label, key_name, density (lib_name defaults to key_name)
!  mat he   0.000176
!  mat inc  8.19
!  mat ss   8.0
!  mat zirc 6.56 zirc4

  cell 1     0.4096 0.418 0.475 / U31 he zirc4
  cell 7            0.418 0.475 / mod    mod        ! empty location
  cell 8            0.418 0.475 /     he zirc4       ! plenum
  cell 9                  0.475 /        zirc4       ! pincap

  lattice FUEL1
     1

  lattice LGAP1
     7

  lattice PLEN1
     8

  lattice PCAP1
     9

  axial A1    6.050
      LGAP1  11.951
      FUEL1 377.711
      PLEN1 393.711
      LGAP1 397.501

  grid END inc   3.866  4.67   0.9070   ! grid height (cm), mass (g), loss coef
  grid MID zirc4 3.810  3.25   0.9065   ! grid height (cm), mass (g), loss coef

  grid_axial
      END  13.884
      MID  75.2
      MID 127.4
      MID 179.6
      MID 231.8
      MID 284.0
      MID 336.2
      END 388.2

  lower_nozzle  ss 6.05   25.0  ! mat, height, mass (g)
  upper_nozzle  ss 8.827  25.0  ! mat, height, mass (g)

[EDITS]

!  3in intervals in active fuel
