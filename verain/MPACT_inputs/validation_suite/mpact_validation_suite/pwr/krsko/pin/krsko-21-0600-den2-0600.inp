[CASEID]
  title 'CASL AMA Benchmark Problem 1A - Pin Cell- Public'

[STATE]
  power    0.0
  tinlet   600 K         ! typical tinlet is 559 F / 566 K
  tfuel    600 K
  modden   0.703158      ! g/cc  tave
  boron    600           ! ppm
  sym      full          ! full symmetry
  feedback off

[CORE]
  size   1
  apitch 1.2319     ! krsko 16x16
  rated  0.01 0.01
  height 1.0

  core_shape
    1

  assm_map
    ASSY1

  bc_rad reflecting
  bc_top reflecting
  bc_bot reflecting

  mat he 0.000176 he-4
  mat zirc 6.56 zr    ! use natural Zr

[ASSEMBLY]
  title "pin cell"
  npin 1
  ppitch 1.2319     ! krsko 16x16

  fuel UXX 10.257 94.5 / 2.1 u-234 0.017275

  cell PIN1 0.4096 0.418 0.475 / UXX he zirc

  lattice LAT1
     PIN1

  axial ASSY1 0.0 LAT1 1.0

[MPACT]
  num_space      1 
  num_angle      1
  num_threads    1

  include ../../mpact_pin.ini
