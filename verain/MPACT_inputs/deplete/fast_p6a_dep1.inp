[CASEID]
  title 'Small Problem 6a: internal CTF'

[STATE]
  power  100.0         ! %
  tinlet 559.0 F       !
  boron  1300          ! ppmB
  pressure 2250        ! psia

  tfuel 900.0 K        !       Not used with T/H feedback! set to 900K with feedback
  modden 0.743         ! g/cc  Not used with T/H feedback!

  feedback on
  sym qtr

  deplete GWDMT 0.0 0.1 0.5 1

[STATE]

  op_date 2000/01/01   ! should not be needed

  restart_write restart.h5 EXP1

[CORE]
  size 1                ! 1x1 single-assembly
  rated 1.6064  0.0590  ! MW, Mlbs/hr
  apitch 6.38
  height 406.328

  op_date 2000/01/01   ! should not be needed

  core_shape
    1

  assm_map
    A1

  xlabel A
  ylabel 1

  lower_plate ss 5.0 0.5   ! mat, thickness, vol frac
  upper_plate ss 7.6 0.5   ! mat, thickness, vol frac
  lower_ref   mod 26.0 1.0
  upper_ref   mod 25.0 1.0


  bc_rad reflecting

  mat he     0.000176
  mat inc    8.19
  mat ss     8.0
  mat zirc   6.56 zirc4
  mat aic   10.20
  mat pyrex  2.23
  mat b4c    6.56

[ASSEMBLY]
  title "Westinghouse 17x17"
  npin 5
  ppitch 1.260

  fuel U31 10.257 95.0 / 3.1

!=== material label, key_name, density (lib_name defaults to key_name)
  mat he   0.000176
  mat inc  8.19
  mat ss   8.0
  mat zirc 6.56 zirc4

  cell 1     0.4096 0.418 0.475 / U31 he zirc
  cell 200          0.561 0.602 / mod    zirc       ! instrument tube
  cell 7            0.418 0.475 / mod    mod        ! empty location
  cell 8            0.418 0.475 /     he zirc       ! plenum
  cell 9                  0.475 /        zirc       ! pincap

  lattice FUEL1
     200
       1 1
       1 1 1

  lattice LGAP1
     200
       7 7
       7 7 7

  lattice PLEN1
     200
       8 8
       8 8 8

  lattice PCAP1
     200
       9 9
       9 9 9

  axial A1    6.050
      LGAP1  10.281
      PCAP1  11.951
      FUEL1 377.711
      PLEN1 393.711
      PCAP1 395.381
      LGAP1 397.501

  grid END inc  88.0 3.866
  grid MID zirc 75.7 3.810

  grid_axial
      END  13.884
      MID  75.2
      MID 127.4
      MID 179.6
      MID 231.8
      MID 284.0
      MID 336.2
      END 388.2

  lower_nozzle  ss 6.05  540.66  ! mat, height, mass (g)
  upper_nozzle  ss 8.827 540.66  ! mat, height, mass (g)

 !! dancoff                   ! assembly_dancoff_map
 !!   0.000
 !!   0.287 0.315
 !!   0.287 0.315 0.315

[EDITS]

!  3in intervals in active fuel
  axial_edit_bounds
          11.951
          15.817
          24.028
          32.239
          40.45
          48.662
          56.873
          65.084
          73.295
          77.105
          85.17
          93.235
          101.3
          109.365
          117.43
          125.495
          129.305
          137.37
          145.435
          153.5
          161.565
          169.63
          177.695
          181.505
          189.57
          197.635
          205.7
          213.765
          221.83
          229.895
          233.705
          241.77
          249.835
          257.9
          265.965
          274.03
          282.095
          285.905
          293.97
          302.035
          310.1
          318.165
          326.23
          334.295
          338.105
          346.0262
          353.9474
          361.8686
          369.7898
          377.711

[COBRATF]
  nc      1             ! conduction option - radial conduction
  irfc    2             ! friction factor correlation default=2
  dhfrac  0.02          ! fraction of power deposited directly into coolant
  hgap    5678.3        ! gap conductance
  epso    0.001
  oitmax  5
  iitmax  40
  gridloss END 0.9070   ! spacer grid loss coefficient
  gridloss MID 0.9065   ! spacer grid loss coefficient
  dtmin   0.000001
  dtmax   0.1
  tend    0.1
  rtwfp   1000.0
  maxits  10000
  parallel 0
  courant 0.8

[COUPLING]
  epsk        25.  ! pcm
  epsp        1.0e-3
  rlx_power   0.6
  rlx_tfuel   1.0
  rlx_den     1.0
  maxiter     15 

[MPACT]
  vis_edits         none
  ray_spacing       0.2
!quad_set
  quad_type         CHEBYSHEV-GAUSS
  polars_octant     2
  azimuthals_octant 8
!iteration_control
  flux_tolerance    1e-4
  num_inners        3
  k_tolerance       1e-4
  up_scatter        2
  num_outers        100
  scattering        LTCP0
!cmfd
  cmfd              cmfd
  cmfd_solver       mgnode
  k_shift           1.5
  cmfd_num_outers   20
!2D1D
  split_TL          true
  TL_treatment      lflat
  nodal_method      nem
!  under_relax       1.0
!TH
  coupling_method   ctf
!parallel
  num_space         12
  num_angle         1
  num_energy        1
  num_threads       1
!xs_library
  xs_filename       mpact47g_e70r0_TCP0.xsl
  xs_type           ORNL
  xs_shielder       t 
  subgroup_set      4
  dep_filename      MPACT.dpl

!mesh
  
  mesh fuel  1 1 1 / 4 4 4 4
  mesh gtube 1 1   / 4 4 4
  meshing_method   matbound 
  automesh_bounds  2.0 20.0
