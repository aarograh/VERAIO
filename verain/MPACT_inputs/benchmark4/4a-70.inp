[INSILICO]
    cell_homogenize true
    eq_set        spn_fv
    SPN_order     3
    Pn_order      1
    tolerance     1e-6
    dimension     3
    mesh          2
    max_delta_z   1.27
    Pn_correction true

    mat_library casl_comp_r2.sh5
    xs_library  lib252_hetbondoneabs-noabssigp

!   pin_partitioning true
    num_blocks_i  12  
    num_blocks_j  12  
    num_z_blocks  1  
    num_groups    23
    num_sets      1

    azimuthals_octant  4
    polars_octant      4
    quad_type          qr

    silo_output  p4 

    new_grp_bounds 
       8.2085e+05 
       1.1109e+05 
       5.5308e+03 
