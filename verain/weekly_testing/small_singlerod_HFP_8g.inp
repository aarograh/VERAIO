[CASEID]
  title 'CASL Problem Singlerod HFP'
!================================================================================
!  Sample input for small singlerod Problem
!
!  Updated 3/18/2013 to be consistent with Problem 6 T/H
!
!  To process:
!     ./react2xml.pl [file].inp [file].xml
!
!================================================================================

[STATE]
  power   10.0         ! %
  tinlet 559.0 F       ! F
  boron  1300          ! ppmB
  pressure 2250        ! psia

  tfuel  900.0 K       ! K - 600K  Not used with T/H feedback! set to 900K with feedback
  modden 0.743         ! g/cc      Not used with T/H feedback!

  feedback on
  sym full

[CORE]
  size 1                  ! 1x1 single-assembly
  rated 0.066932 0.00260  ! MW, Mlbs/hr  *** scaled to 1x1, increased flow to match 17x17 outlet conditions
  apitch 1.270            ! *** scaled to 1x1, no gap but larger flow area
  height 406.328

  core_shape
    1

  assm_map
    A1

  ! add material definitions for he, inc, ss, and zirc4.
  include casl_comp_r3_full.ini

  lower_plate ss 5.0 0.5   ! mat, thickness, vol frac
  upper_plate ss 7.6 0.5   ! mat, thickness, vol frac
  lower_ref   mod 26.0 1.0
  upper_ref   mod 25.0 1.0

  bc_rad reflecting

[ASSEMBLY]
  title "Westinghouse 17x17"
  npin 1        ! *** scaled to 1x1 rod
  ppitch 1.270  ! *** increased for 1x1 to get rid of gap

  fuel U31 10.257 95.0 / 3.1

  cell 1     0.4096 0.418 0.475 / U31 he zirc4
  cell 100          0.561 0.602 / mod    zirc4       ! guide tube
  cell 200          0.561 0.602 / mod    zirc4       ! instrument tube
  cell 7            0.418 0.475 / mod    mod         ! empty location
  cell 8            0.418 0.475 /     he zirc4       ! plenum
  cell 9                  0.475 /        zirc4       ! pincap

  lattice FUEL1
     1

  lattice LGAP1
     7

  lattice PLEN1
     8

  lattice PCAP1
     9

  axial A1    6.050
      LGAP1  10.281
      PCAP1  11.951
      FUEL1 377.711
      PLEN1 393.711
      PCAP1 395.381
      LGAP1 397.501

  grid END inc   3.866 3.519 0.9070 ! grid height (cm), mass (g), loss coef *** mass scaled to 1x1 rod
  grid MID zirc4 3.810 3.028 0.9065 ! grid height (cm), mass (g), loss coef *** mass scaled to 1x1 rod

  grid_axial
      END  13.884
      MID  75.2
      MID 127.4
      MID 179.6
      MID 231.8
      MID 284.0
      MID 336.2
      END 388.2

  lower_nozzle  ss 6.05  21.626  ! mat, height, mass (g)  *** mass scaled to 1x1 rod
  upper_nozzle  ss 8.827 21.626  ! mat, height, mass (g)  *** mass scaled to 1x1 rod

[EDITS]

!  3in intervals in active fuel
  axial_edit_bounds
          11.951
          15.817
          24.028
          32.239
          40.45
          48.662
          56.873
          65.084
          73.295
          77.105
          85.17
          93.235
          101.3
          109.365
          117.43
          125.495
          129.305
          137.37
          145.435
          153.5
          161.565
          169.63
          177.695
          181.505
          189.57
          197.635
          205.7
          213.765
          221.83
          229.895
          233.705
          241.77
          249.835
          257.9
          265.965
          274.03
          282.095
          285.905
          293.97
          302.035
          310.1
          318.165
          326.23
          334.295
          338.105
          346.0262
          353.9474
          361.8686
          369.7898
          377.711

[INSILICO]
    xs_library  test-8grp

    max_delta_z   2.54
    num_blocks_i  2
    num_blocks_j  2
    num_z_blocks  1
    num_groups    8
    num_sets      1

    mesh          2
    dimension     3
    eq_set        spn_fv
    SPN_order     3
!!  cell_homogenize true  ! do not include for fast 8-group problem
    tolerance     1e-6
    Pn_order      0

!   silo_db:
       silo_output  p6
!      silo_out_power true

!   upscatter_db:
       upscatter_tolerance  1e-4

[COBRATF]
  nfuel   3             ! number of fuel rings in conduction model
  nc      1             ! conduction option - radial conduction
  irfc    2             ! friction factor correlation default=2
  dhfrac  0.02          ! fraction of power deposited directly into coolant
  hgap    5678.3        ! gap conductance
  epso    0.001
  oitmax  5
  iitmax  40
  dtmin   0.000001
  dtmax   0.1
  tend    0.1
  rtwfp   1000.0
  maxits  10000
  courant 0.8
  edit_channels 1
  maps_filename = single_rod_HFP
  global_energy_balance    0.01 !%
  global_mass_balance      0.01 !%
  fluid_energy_storage     0.5  !%
  solid_energy_storage     0.5  !%
  mass_storage             0.5  !%

[COUPLING]
  epsk        2.0  ! pcm
  eps_boron   0.1  ! boron convergence (ppm)
  rlx_power   0.5
  rlx_tfuel   1.0
  rlx_den     1.0
  maxiter     20
